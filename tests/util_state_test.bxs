// JsonStore (read, load), Mutation, SystemFile and SystemdUnit. Run from src/: (cd src && matchbox ../tests/util_state_test.bxs)
testkit = new lib.Check( "util state" );
dir = testkit.tmp();
js = new bxrig.util.JsonStore();
f = dir & "/a.json";
testkit.check( "a missing file gives the defaults", js.read( f, { x: 1 } ).x == 1 && structCount( js.load( f ) ) == 0 );
testkit.text( f, '{"x":2,"y":"z"}' );
r = js.read( f, { x: 1, w: 9 } );
testkit.check( "the file is laid over the defaults", r.x == 2 && r.y == "z" && r.w == 9 );
testkit.text( f, "not json" );
testkit.check( "an invalid file gives the defaults and never throws", js.read( f, { x: 1 } ).x == 1 );
testkit.text( f, "[1,2]" );
testkit.check( "a non-struct file gives the defaults from read, the value from load", js.read( f, { x: 1 } ).x == 1 && js.load( f ).len() == 2 );
calls = [];
proc = new bxrig.util.Proc( function( argv, timeout ) { calls.append( argv.toList( " " ) & "@" & timeout ); return { exitCode: argv[ 1 ] == "bad" ? 1 : 0, timeout: false, output: "boom" }; } );
said = [];
fakeOut = { say: function( code, data, asJson, lines = [], dry = false ) { said.append( { code: code, data: data, lines: lines, dry: dry } ); return 0; } };
m = new bxrig.util.Mutation( fakeOut, proc );
m.run( "do it", [ [ "a", "1" ], [ "b" ] ], false, false, false, {}, [ "writes x" ], 10 );
testkit.check( "no --yes is a plan and nothing runs", said[ 1 ].code == "plan" && calls.len() == 0 && said[ 1 ].lines[ 1 ] == "Plan: do it" && said[ 1 ].lines[ 2 ] == "  writes x" && said[ 1 ].lines[ 3 ] == "  a 1" && said[ 1 ].lines[ 5 ] == "Nothing was changed. Add --yes to apply." );
m.run( "do it", [ [ "a" ] ], true, true, false );
testkit.check( "--dry-run is ok, shows Dry run and runs nothing", said[ 2 ].code == "ok" && said[ 2 ].dry && said[ 2 ].lines[ 1 ] == "Dry run: do it" && calls.len() == 0 );
m.run( "do it", [ [ "a", "1" ], [ "b" ] ], true, false, false, {}, [], 7 );
testkit.check( "--yes runs every command with the timeout and says done", calls.len() == 2 && calls[ 1 ] == "a 1@7" && said[ 3 ].code == "ok" && said[ 3 ].lines[ 1 ] == "do it: done" );
calls = [];
m.run( "do it", [ [ "bad" ], [ "never" ] ], true, false, false );
testkit.check( "the first failure stops the run and fails", calls.len() == 1 && said[ 4 ].code == "failed" && said[ 4 ].data.step == "bad" );
sf = new bxrig.util.SystemFile( proc );
testkit.check( "install argv", sf.installArgv( "/t", "/etc/x" ).toList( " " ) == "sudo install -Dm644 /t /etc/x" && sf.installArgv( "/t", "/etc/s", "440", true ).toList( " " ) == "sudo install -Dm440 -o root -g root /t /etc/s" );
testkit.check( "temp paths are unique", sf.tempPath( "a" ) != sf.tempPath( "a" ) && find( "bxrig-a-", sf.tempPath( "a" ) ) > 0 );
t = sf.stage( "secret", "unit" );
testkit.check( "stage writes the text", fileRead( t ) == "secret" );
sf.cleanup( [ t, dir & "/none" ] );
testkit.check( "cleanup removes and ignores missing", !fileExists( t ) );
u = new bxrig.util.SystemdUnit().render( [ { name: "Unit", lines: [ "Description=d" ] }, { name: "Service", lines: [ "ExecStart=/x", "Restart=no" ] } ], "Written by bxrig" );
testkit.check( "a unit renders with a header, blank lines between sections and a final newline", u == "## Written by bxrig" & chr( 10 ) & "[Unit]" & chr( 10 ) & "Description=d" & chr( 10 ) & chr( 10 ) & "[Service]" & chr( 10 ) & "ExecStart=/x" & chr( 10 ) & "Restart=no" & chr( 10 ) || left( u, 2 ) == "# " );
testkit.check( "no header means the first line is the first section", left( new bxrig.util.SystemdUnit().render( [ { name: "Timer", lines: [ "OnCalendar=daily" ] } ] ), 7 ) == "[Timer]" );
testkit.done( "util state tests passed" );
