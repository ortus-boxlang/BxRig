// BarLayouts (the three top bar layouts as data) and LookPreview (their pictures). Run from src/: (cd src && matchbox ../tests/bar_layouts_test.bxs)
testkit = new lib.Check( "bar layouts" );
bl = new bxrig.BarLayouts();
testkit.check( "three layouts: Minimal, Standard (default, recommended) and Dense", bl.order().toList( "," ) == "minimal,standard,dense" && bl.layout( "standard" ).tag == "recommended, default" && bl.layout( "dense" ).name == "Dense" );
testkit.check( "an unknown layout is Standard", bl.layout( "huge" ).key == "standard" && !bl.valid( "huge" ) );

testkit.check( "Standard has the capture icon, Minimal does not, Dense has everything", bl.carries( "standard", "cap" ) && !bl.carries( "minimal", "cap" ) && bl.carries( "dense", "cap" ) );
testkit.check( "Dense adds brightness and weather to Standard", bl.carries( "dense", "bright" ) && bl.carries( "dense", "weather" ) && !bl.carries( "standard", "bright" ) && !bl.carries( "standard", "weather" ) );
testkit.check( "Minimal keeps workspaces, the active window and quick settings (DESKTOP-DECISIONS.md)", bl.carries( "minimal", "ws" ) && bl.carries( "minimal", "win" ) && bl.carries( "minimal", "quick" ) && !bl.carries( "minimal", "clip" ) );
function ids( k ) { var l = bl.layout( k ); var out = []; for ( var z in [ l.L, l.C, l.R ] ) for ( var i in z ) out.append( i ); return out; }
function holds( big, small ) { for ( var i in small ) if ( !arrayFind( big, i ) ) return false; return true; }
testkit.check( "each layout holds the one before it (Minimal in Standard in Dense)", holds( ids( "standard" ), ids( "minimal" ) ) && holds( ids( "dense" ), ids( "standard" ) ) );
testkit.check( "clipboard history is on the right, quick settings then control center last", bl.layout( "standard" ).R[ bl.layout( "standard" ).R.len() ] == "ctl" && bl.layout( "standard" ).R[ bl.layout( "standard" ).R.len() - 1 ] == "quick" && bl.carries( "standard", "clip" ) );
testkit.check( "every chip id used is a known chip", ids( "dense" ).filter( function( i ) { return !structKeyExists( bl.chips(), i ); } ).len() == 0 );

// the strip in a given width
wide = bl.rows( "standard", 200 );
testkit.check( "wide: one row with the three zones side by side", wide.len() == 1 && wide[ 1 ].mode == "one" );
narrow = bl.rows( "dense", 60 );
fits = true; count = 0;
for ( r in narrow ) { for ( z in [ r.l, r.c, r.r ] ) { if ( bl.zoneWidth( z ) > 58 ) fits = false; count += z.len(); } }
testkit.check( "narrow: the zones wrap onto more rows, every row fits, no chip is lost", narrow.len() > 1 && fits && count == ids( "dense" ).len() );
testkit.check( "height says how many rows the strip takes", bl.height( "dense", 60 ) == narrow.len() && bl.height( "minimal", 200 ) == 1 );
testkit.check( "the battery percentage adds ' 78%' to the battery chip", find( "78%", bl.zone( [ "bat" ], true )[ 1 ].t ) > 0 && find( "78%", bl.zone( [ "bat" ], false )[ 1 ].t ) == 0 );
testkit.check( "the dock starts with the grid button", bl.dock().len() == 5 && bl.dock()[ 1 ].t == "◍" );

// drawn
tui = createObject( "rust", "tui.TUI" );
kit = new bxrig.TuiKit( tui );
pv = new bxrig.LookPreview( kit );
function draw( key, w = 120 ) { tui.begin_frame(); pv.strip( 0, 0, w, key, true ); return tui.render_to_string( w, 4 ); }
testkit.check( "drawn: Standard shows the capture icon, Minimal does not", find( "◉", draw( "standard" ) ) > 0 && find( "◉", draw( "minimal" ) ) == 0 && find( "☁", draw( "dense" ) ) > 0 && find( "☁", draw( "standard" ) ) == 0 );
testkit.check( "drawn: the clock reads Nov 5 - 04:00", find( "Nov 5 - 04:00", draw( "standard" ) ) > 0 );
tui.begin_frame(); h = pv.appGrid( 0, 0, 40, "launchpad", true ); g1 = tui.render_to_string( 80, 14 );
tui.begin_frame(); pv.appGrid( 0, 0, 40, "terminal", true ); g2 = tui.render_to_string( 80, 14 );
testkit.check( "app grids: Launchpad has big tiles and a search box, Terminal-style has key hints and square corners", h == pv.gridHeight( 2 ) && find( "Search apps", g1 ) > 0 && find( "╭", g1 ) > 0 && find( "◆", g1 ) > 0 && find( "/ search apps", g2 ) > 0 && find( "esc", g2 ) > 0 && find( "┌", g2 ) > 0 && find( "╭", g2 ) == 0 );
// the wizard page and the data agree: same layouts in the same order, the page's description is the layout's own text
spec = jsonDeserialize( new bxrig.WizardData().demoPages() );
barQ = spec.pages.filter( function( pg ) { return pg.id == "top_bar"; } )[ 1 ].questions[ 1 ];
testkit.check( "the Top bar layout page lists BarLayouts.order(), labelled with the layout names", barQ.options.map( function( o ) { return o.value; } ).toList( "," ) == bl.order().toList( "," ) && barQ.options.filter( function( o ) { return o.label == bl.layout( o.value ).name; } ).len() == 3 );
testkit.check( "each option's description starts with the layout's detail and names the command", barQ.options.filter( function( o ) { return left( o.description, len( bl.layout( o.value ).detail ) ) == bl.layout( o.value ).detail && find( "bxrig appearance bar layout " & o.value, o.description ) > 0; } ).len() == 3 );
testkit.done();
