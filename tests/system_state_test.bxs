// SystemState: what the machine has, in wizard terms, with an injected installed set. Run from src/: (cd src && matchbox ../tests/system_state_test.bxs)
testkit = new lib.Check( "system state" );
spec = jsonDeserialize( new bxrig.WizardData().demoPages() );
names = {}; for ( n in [ "git", "curl", "hyprland", "plasma-desktop", "ollama", "claude-code" ] ) names[ n ] = true;
sys = new bxrig.SystemState( names );
found = sys.scan( spec );
testkit.check( "desktops: both when Hyprland and Plasma are installed", found.answers.desktops == "both" );
testkit.check( "multi: installed AI agent is selected", isArray( found.answers.ai_agents ) && arrayFind( found.answers.ai_agents, "claude-code" ) > 0 );
testkit.check( "installed map lists ollama", structKeyExists( found.installed, "ai_local" ) && arrayFind( found.installed.ai_local, "ollama" ) > 0 );
testkit.check( "appInstalled true/false", sys.appInstalled( "git" ) && !sys.appInstalled( "timeshift" ) );
fr = sys.startingAnswers( { a: 1 }, found.answers, "fresh" );
testkit.check( "startingAnswers fresh keeps only what the machine is (power_setup, input_detected)", structCount( fr ) <= 2 && !structKeyExists( fr, "a" ) && ( structCount( fr ) == 0 || structKeyExists( fr, "power_setup" ) || structKeyExists( fr, "input_detected" ) ) );
testkit.check( "startingAnswers rerun is saved only", structCount( sys.startingAnswers( { a: 1 }, found.answers, "rerun" ) ) == 1 );
m = sys.startingAnswers( { ai_agents: [ "codex-cli" ], keep: "x" }, found.answers, "tune" );
testkit.check( "startingAnswers tune joins lists and keeps saved keys", arrayFind( m.ai_agents, "codex-cli" ) > 0 && arrayFind( m.ai_agents, "claude-code" ) > 0 && m.keep == "x" );
ann = sys.annotate( spec, found.installed );
mark = false;
for ( pg in ann.pages ) for ( q in pg.questions ) if ( structKeyExists( q, "options" ) && q.id == "ai_local" ) for ( o in q.options ) if ( o.value == "ollama" && structKeyExists( o, "installed" ) ) mark = true;
testkit.check( "annotate marks installed options", mark );
testkit.done( "all ok" );
