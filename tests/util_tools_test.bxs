// Pacman, Aur, Systemd and Http: the argv they build and the answers they read from a runner. Run from src/: (cd src && matchbox ../tests/util_tools_test.bxs)
testkit = new lib.Check( "util tools" );
calls = [];
answers = {};
fake = function( argv, timeout ) {
	calls.append( argv.toList( " " ) );
	key = argv.toList( " " );
	if ( structKeyExists( answers, key ) ) return answers[ key ];
	return { exitCode: 0, timeout: false, output: "" };
};
proc = new bxrig.util.Proc( fake );
pac = new bxrig.util.Pacman( proc );
testkit.check( "install argv with sudo", pac.installArgv( [ "a", "b" ] ).toList( " " ) == "sudo pacman -S --needed --noconfirm a b" );
testkit.check( "install argv as root has no sudo", pac.installArgv( "a", true ).toList( " " ) == "pacman -S --needed --noconfirm a" );
testkit.check( "remove argv default purges config", pac.removeArgv( [ "x" ] ).toList( " " ) == "sudo pacman -Rns --noconfirm x" );
testkit.check( "remove argv keeps config on request", pac.removeArgv( [ "x" ], "-Rs" ).toList( " " ) == "sudo pacman -Rs --noconfirm x" );
testkit.check( "upgrade argv", pac.upgradeArgv().toList( " " ) == "sudo pacman -Syu --noconfirm" );
testkit.check( "install line for plans", pac.installLine( [ "a", "b" ] ) == "sudo pacman -S --needed a b" );
answers[ "pacman -Qq" ] = { exitCode: 0, timeout: false, output: "bash" & chr( 10 ) & "git" & chr( 10 ) };
inst = pac.installed();
testkit.check( "installed is a set of names", structKeyExists( inst, "git" ) && structKeyExists( inst, "bash" ) && structCount( inst ) == 2 );
answers[ "pacman -Qqe" ] = { exitCode: 0, timeout: false, output: "git" & chr( 10 ) };
testkit.check( "explicit is an array", pac.explicit().len() == 1 && pac.explicit()[ 1 ] == "git" );
answers[ "pacman -Q nope" ] = { exitCode: 1, timeout: false, output: "" };
testkit.check( "has: installed and not installed", pac.isInstalled( "git" ) && !pac.isInstalled( "nope" ) );
answers[ "pacman -Qqm" ] = { exitCode: 1, timeout: false, output: "error" };
testkit.check( "a failing query is an empty list", pac.foreign().len() == 0 );
answers[ "pacman -Si x" ] = { exitCode: 0, timeout: false, output: " Name : x " & chr( 10 ) };
testkit.check( "known and info", pac.known( "x" ) && pac.info( "x" ) == "Name : x" );
answers[ "pacman -Ss --color never foo" ] = { exitCode: 0, timeout: false, output: "extra/foo 1" };
testkit.check( "search keeps the raw text", pac.search( "foo" ).output == "extra/foo 1" );
aur = new bxrig.util.Aur( proc );
testkit.check( "aur install argv", aur.installArgv( [ "p" ] ).toList( " " ) == "yay -S --needed --noconfirm p" );
testkit.check( "aur upgrade argv", aur.upgradeArgv().toList( " " ) == "yay -Sua --noconfirm" );
sd = new bxrig.util.Systemd( proc );
testkit.check( "enable user unit", sd.enableArgv( "x.service", true ).toList( " " ) == "systemctl --user enable --now x.service" );
testkit.check( "disable system unit with sudo", sd.disableArgv( [ "a", "b" ], false, true ).toList( " " ) == "sudo systemctl disable --now a b" );
testkit.check( "reload and stop", sd.reloadArgv( true ).toList( " " ) == "systemctl --user daemon-reload" && sd.stopArgv( "t", true ).toList( " " ) == "systemctl --user stop t" );
testkit.check( "power verbs", sd.powerArgv( "shutdown" ).toList( " " ) == "systemctl poweroff" && sd.powerArgv( "reboot" ).toList( " " ) == "systemctl reboot" );
answers[ "systemctl --user is-active --quiet u" ] = { exitCode: 3, timeout: false, output: "" };
testkit.check( "active reads the exit code (--quiet)", !sd.active( "u", true ) && sd.active( "v", true ) );
answers[ "systemctl is-active o" ] = { exitCode: 0, timeout: false, output: "active" & chr( 10 ) };
testkit.check( "state reads the text", sd.state( "o" ) == "active" && sd.isActive( "o" ) && !sd.isActive( "other" ) );
http = new bxrig.util.Http( proc );
testkit.check( "get argv", http.getArgv( "http://x", 20 ).toList( " " ) == "curl -fsSL --max-time 20 http://x" );
testkit.check( "get argv without redirects", http.getArgv( "http://x", 20, false ).toList( " " ) == "curl -fsS --max-time 20 http://x" );
testkit.check( "download argv", http.downloadArgv( "http://x", "/t/f", 9 ).toList( " " ) == "curl -fsSL --max-time 9 -o /t/f http://x" );
testkit.check( "installer argv puts the url and args after the script", http.installerArgv( "http://i", "sh", [ "--yes" ] )[ 5 ] == "http://i" && http.installerArgv( "http://i", "sh", [ "--yes" ] )[ 6 ] == "--yes" );
answers[ "curl -fsSL --max-time 5 http://ok" ] = { exitCode: 0, timeout: false, output: "body" };
answers[ "curl -fsSL --max-time 5 http://bad" ] = { exitCode: 22, timeout: false, output: "err" };
testkit.check( "get answers ok and output", http.get( "http://ok", 5 ).ok && http.get( "http://ok", 5 ).output == "body" && !http.get( "http://bad", 5 ).ok );
answers[ "curl -sS --max-time 10 -o - -w " & chr( 10 ) & "%{http_code} -X GET http://l/p" ] = { exitCode: 0, timeout: false, output: "{}" & chr( 10 ) & "200" };
rq = http.request( "GET", "http://l/p" );
testkit.check( "request splits the body and the status", rq.ok && rq.status == 200 && rq.body == "{}" );
answers[ "curl -sS --max-time 10 -o - -w " & chr( 10 ) & "%{http_code} -X GET http://l/q" ] = { exitCode: 0, timeout: false, output: "no" & chr( 10 ) & "404" };
testkit.check( "request: a 404 is not ok", !http.request( "GET", "http://l/q" ).ok && http.request( "GET", "http://l/q" ).status == 404 );
testkit.done( "util tools tests passed" );
