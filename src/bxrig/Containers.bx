// `bxrig containers`: Podman made comfortable, and docker commands that work on it.
//   doctor                  checks: Podman installed, rootless, subuid/subgid, compose, the user socket, the docker shim
//   socket enable [--yes]   starts the rootless API socket (systemctl --user enable --now podman.socket) and prints DOCKER_HOST
//   docker-compat [--yes]   installs podman-docker (a `docker` command that runs Podman) and podman-compose (`sudo pacman -S --needed`)
// podman-docker conflicts with the docker package, so it is refused while docker is installed. Package names checked on archlinux.org
// 2026-11-12 (podman-docker ships /usr/bin/docker; podman ships podman.socket as a user unit too).
// Exit: 0 done / all checks pass, 2 plan without --yes, 4 precondition (or a check failed in `doctor`), 6 a command failed.
class Containers {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.proc = new bxrig.util.Proc( arguments.runner );
        variables.pacman = new bxrig.util.Pacman( variables.proc );
        variables.systemd = new bxrig.util.Systemd( variables.proc );
        return this;
    }

    function check( id, ok, detail, fix = "" ) { return { id: arguments.id, ok: arguments.ok, detail: arguments.detail, fix: arguments.fix }; }

    // `containers doctor`
    function doctor( asJson ) {
        var rows = [];
        var podman = variables.proc.has( "podman" );
        rows.append( check( "podman", podman, podman ? "installed" : "not installed", "bxrig profile-install containers" ) );
        if ( podman ) {
            var rl = variables.proc.exec( [ "podman", "info", "--format", "{{.Host.Security.Rootless}}" ], 30 );
            var rootless = trim( rl.output ) == "true";
            rows.append( check( "rootless", rootless, rootless ? "running without root" : "podman is not rootless for this user" ) );
            var user = new bxrig.util.Env().named( "user", "" );
            var etc = new bxrig.util.Env().named( "etc", "/etc" );
            var subs = variables.proc.exec( [ "sh", "-c", 'grep -q "^$1:" "$2/subuid" && grep -q "^$1:" "$2/subgid"', "_", user, etc ], 10 ).exitCode == 0;
            rows.append( check( "subuid", subs, subs ? "subuid and subgid entries exist" : "no subuid/subgid range for " & user, "sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 " & user ) );
            var compose = variables.proc.has( "podman-compose" ) || variables.proc.has( "docker-compose" );
            rows.append( check( "compose", compose, compose ? "a compose tool is installed" : "no compose tool", "bxrig containers docker-compat" ) );
            var sock = variables.systemd.isActive( "podman.socket", true );
            rows.append( check( "socket", sock, sock ? "the user socket is active" : "the user socket is not active (tools that expect the Docker API need it)", "bxrig containers socket enable" ) );
            var shim = variables.proc.has( "docker" ) && find( "podman", lcase( variables.proc.exec( [ "docker", "--version" ], 10 ).output ) ) > 0;
            rows.append( check( "docker-shim", shim, shim ? "`docker` runs Podman" : "no docker command that runs Podman", "bxrig containers docker-compat" ) );
        }
        var bad = rows.filter( function( r ) { return !r.ok; } );
        var lines = rows.map( function( r ) { return ( r.ok ? "ok    " : "FIX   " ) & r.id & ": " & r.detail & ( !r.ok && len( r.fix ) ? "   -> " & r.fix : "" ); } );
        return variables.cli.say( "containers doctor", bad.len() ? "precondition" : "ok", { ok: !bad.len(), checks: rows }, arguments.asJson, lines );
    }

    // `containers socket enable [--yes]`
    function socketEnable( yes, asJson ) {
        var cmd = "containers socket enable";
        var argv = variables.systemd.enableArgv( "podman.socket", true );
        var host = "unix://" & new bxrig.util.Env().named( "xdgRuntimeDir", "/run/user/1000" ) & "/podman/podman.sock";
        if ( !variables.proc.has( "podman" ) ) return variables.cli.say( cmd, "precondition", { error: "Podman is not installed" }, arguments.asJson, [ "error: Podman is not installed. Install it: bxrig profile-install containers" ] );
        if ( !arguments.yes ) return variables.cli.say( cmd, "plan", { command: argv, docker_host: host }, arguments.asJson, [ "Plan: " & argv.toList( " " ), "Then tools that speak the Docker API use DOCKER_HOST=" & host, "Nothing was changed. Add --yes to apply." ] );
        var r = variables.proc.exec( argv, 30 );
        if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return variables.cli.say( cmd, "ok", { docker_host: host }, arguments.asJson, [ "The Podman socket is active.", "Point Docker-API tools at it: export DOCKER_HOST=" & host ] );
    }

    // `containers docker-compat [--yes]`
    function dockerCompat( yes, asJson ) {
        var cmd = "containers docker-compat";
        if ( variables.pacman.isInstalled( "docker" ) ) return variables.cli.say( cmd, "precondition", { error: "docker is installed" }, arguments.asJson, [ "error: the docker package is installed and conflicts with podman-docker. Remove it first, or keep using real Docker (bxrig db engine docker)." ] );
        var pkgs = [];
        for ( var p in [ "podman-docker", "podman-compose" ] ) if ( !variables.pacman.isInstalled( p ) ) pkgs.append( p );
        var data = { packages: pkgs };
        if ( !pkgs.len() ) return variables.cli.say( cmd, "ok", data, arguments.asJson, [ "Already in place: `docker` runs Podman and podman-compose is installed." ] );
        if ( !arguments.yes ) return variables.cli.say( cmd, "plan", data, arguments.asJson, [ "Plan: " & variables.pacman.installLine( pkgs ), "After it, `docker ...` and `docker compose ...` run on Podman.", "Nothing was changed. Add --yes to apply." ] );
        var r = variables.proc.exec( variables.pacman.installArgv( pkgs ), 1800 );
        if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: could not install " & pkgs.toList( ", " ) & ": " & trim( r.output ) ] );
        return variables.cli.say( cmd, "ok", data, arguments.asJson, [ "Installed " & pkgs.toList( ", " ) & ". `docker` now runs Podman. Optional: bxrig containers socket enable" ] );
    }
}
