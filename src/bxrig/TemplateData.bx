            case "noctalia-plugins/world-clock/bxrig.luau":
                return replace( '--!nonstrict
-- Runs `bxrig <args> --json`-style commands and unwraps BxRig''s JSON envelope
-- ({ "ok": true, "data": {...} }). Each entry loads its own copy; the same file
-- ships in every BxRig plugin.
--
-- The executable comes from the plugin-level "command" setting (default
-- "bxrig"), so a user whose shell PATH lacks ~/.local/bin can point it at an
-- absolute path.

local M = {}

local function trim(s)
  return noctalia.string.trim(s or "")
end

function M.command()
  local cmd = noctalia.getConfig("command")
  if type(cmd) ~= "string" or trim(cmd) == "" then
    cmd = "bxrig"
  end
  cmd = trim(cmd)
  if cmd:sub(1, 1) == "~" then
    cmd = noctalia.expandPath(cmd)
  end
  return cmd
end

local function argv(args)
  local out = { M.command() }
  for _, a in ipairs(args) do
    table.insert(out, a)
  end
  return out
end

local function firstLine(s)
  s = trim(s)
  local line = s:match("^[^@@BS@@n]*") or s
  return line
end

-- callback(data, err): data is the envelope''s `data` table on success.
function M.json(args, callback, timeoutMs)
  local started = noctalia.runAsync(argv(args), function(res)
    if res.timedOut then
      callback(nil, "bxrig timed out")
      return
    end
    local decoded = noctalia.json.decode(res.stdout or "")
    if type(decoded) ~= "table" then
      local why = firstLine(res.stderr)
      if why == "" then
        why = `bxrig exited with code {res.exitCode}`
      end
      callback(nil, why)
      return
    end
    if decoded.ok ~= true then
      local why = nil
      if type(decoded.data) == "table" and type(decoded.data.error) == "string" then
        why = decoded.data.error
      elseif type(decoded.error) == "string" then
        why = decoded.error
      end
      callback(nil, why or "bxrig reported an error")
      return
    end
    callback(type(decoded.data) == "table" and decoded.data or {}, nil)
  end, timeoutMs or 15000)
  if not started then
    callback(nil, "could not start " .. M.command())
  end
end

-- Runs a bxrig command; onDone(ok, message) is optional.
function M.run(args, onDone, timeoutMs)
  if onDone == nil then
    return noctalia.runAsync(argv(args))
  end
  return noctalia.runAsync(argv(args), function(res)
    local ok = res.exitCode == 0 and not res.timedOut
    local msg = firstLine(res.stderr)
    if msg == "" then
      msg = firstLine(res.stdout)
    end
    onDone(ok, msg)
  end, timeoutMs or 60000)
end

return M' & chr( 10 ), '@@BS@@', chr( 92 ), 'all' );
            case "noctalia-plugins/world-clock/panel.luau":
                return '--!nonstrict
-- BxRig World Clock panel: "It''s HH:MM here in <city>", then one card per zone
-- with its date, big time, abbreviation + offset from local, and a day bar
-- whose sun/moon marker shows where in its day that zone is.
--
-- Data: `bxrig time world --json`, fetched on open and every 30 s while open.
-- Colors are palette roles only, so the panel follows the active theme.

local bxrig = require("./bxrig.luau")

local REFRESH_MS = 30000

local data = nil -- last good `data` table
local errorText = nil
local loading = false
local lastFetchMs = -REFRESH_MS
local closeButton = true

local function str(v)
  if v == nil then
    return ""
  end
  return tostring(v)
end

local function clamp01(x)
  x = tonumber(x) or 0
  if x < 0 then
    return 0
  elseif x > 1 then
    return 1
  end
  return x
end

local function dateLine(zone)
  local text = str(zone.date)
  local rel = str(zone.relative_day)
  local suffix = nil
  if rel == "tomorrow" then
    suffix = "Tomorrow"
  elseif rel == "yesterday" then
    suffix = "Yesterday"
  end
  if suffix ~= nil then
    if text == "" then
      return suffix
    end
    return `{text} · {suffix}`
  end
  return text
end

-- Thin track with a sun/moon marker at day_fraction (0 = local midnight).
local function dayBar(zone, key)
  local f = clamp01(zone.day_fraction)
  local isDay = zone.is_day == true
  return ui.row({ key = key, align = "center", gap = 0, height = 14 }, {
    ui.box({ flexGrow = f, height = 2, radius = 1, fill = "on_surface_variant/0.35" }),
    ui.glyph({
      name = isDay and "sun" or "moon",
      size = 14,
      color = isDay and "tertiary" or "secondary",
    }),
    ui.box({ flexGrow = 1 - f, height = 2, radius = 1, fill = "on_surface_variant/0.35" }),
  })
end

local function zoneCard(zone, index)
  local sub = str(zone.abbrev)
  local offset = str(zone.offset)
  if offset ~= "" and offset ~= "+0h" and offset ~= "0h" then
    sub = sub == "" and offset or `{sub} {offset}`
  end
  local key = "zone-" .. index .. "-" .. str(zone.tz)
  return ui.column({
    key = key,
    gap = 6,
    paddingH = 14,
    paddingV = 12,
    radius = 12,
    fill = "surface_container",
  }, {
    ui.row({ align = "center", gap = 8 }, {
      ui.column({ flexGrow = 1, gap = 3 }, {
        ui.label({ text = str(zone.label ~= nil and zone.label or zone.tz), fontSize = 15, fontWeight = "bold", maxLines = 1 }),
        ui.label({ text = dateLine(zone), fontSize = 11, color = "on_surface_variant", maxLines = 1 }),
      }),
      ui.column({ align = "end", gap = 2 }, {
        ui.label({ text = str(zone.time), fontSize = 22, fontWeight = "bold", color = "on_surface" }),
        ui.label({ text = sub, fontSize = 11, color = "on_surface_variant" }),
      }),
    }),
    dayBar(zone, key .. "-bar"),
  })
end

local function render()
  local sections = {}

  -- Header: "It''s 15:48 here in Fort Lauderdale", then the title with a globe.
  local here = data and data.here or nil
  local hereText = ""
  if type(here) == "table" and str(here.time) ~= "" then
    hereText = str(here.city) ~= "" and `It''s {here.time} here in {here.city}` or `It''s {here.time} here`
  end
  local buttons = {
    ui.button({
      glyph = "refresh",
      variant = "ghost",
      controlSize = "sm",
      tooltip = "Refresh",
      onClick = "onRefresh",
    }),
  }
  if closeButton then
    table.insert(buttons, ui.button({ glyph = "close", variant = "ghost", controlSize = "sm", onClick = "onCloseClicked" }))
  end
  -- The buttons sit right of the title; an equal-width spacer on the left
  -- keeps "World (globe) Clock" centered.
  local buttonsWidth = ##buttons * 36
  table.insert(sections, ui.column({ align = "stretch", gap = 2, paddingV = 2 }, {
    ui.label({ text = hereText, fontSize = 12, color = "on_surface_variant", maxLines = 1, textAlign = "center" }),
    ui.row({ align = "center", gap = 8 }, {
      ui.spacer({ width = buttonsWidth }),
      ui.spacer({ flexGrow = 1 }),
      ui.label({ text = "World", fontSize = 18, fontWeight = "bold" }),
      ui.glyph({ name = "world", size = 22, color = "primary" }),
      ui.label({ text = "Clock", fontSize = 18, fontWeight = "bold" }),
      ui.spacer({ flexGrow = 1 }),
      ui.row({ width = buttonsWidth, gap = 4, justify = "end", align = "center" }, buttons),
    }),
  }))

  local zones = data and data.zones or nil
  if data == nil then
    local text = errorText ~= nil and errorText or "Loading…"
    table.insert(sections, ui.column({ paddingV = 16, align = "center", gap = 6 }, {
      ui.glyph({ name = errorText ~= nil and "alert-triangle" or "loader", size = 20, color = errorText ~= nil and "error" or "on_surface_variant" }),
      ui.label({ text = text, fontSize = 12, color = "on_surface_variant", textAlign = "center", maxLines = 4 }),
    }))
  elseif type(zones) ~= "table" or ##zones == 0 then
    table.insert(sections, ui.label({
      text = "No world clocks configured. Add some with bxrig.",
      fontSize = 12,
      color = "on_surface_variant",
      textAlign = "center",
    }))
  else
    local cards = {}
    for i, zone in ipairs(zones) do
      if type(zone) == "table" then
        table.insert(cards, zoneCard(zone, i))
      end
    end
    table.insert(sections, ui.scroll({ flexGrow = 1, gap = 8 }, cards))
    if errorText ~= nil then
      table.insert(sections, ui.label({ text = errorText, fontSize = 10, color = "error", maxLines = 2 }))
    end
  end

  panel.render(ui.column({ flexGrow = 1, gap = 10, padding = 10 }, sections))
end

local function fetch()
  if loading then
    return
  end
  loading = true
  lastFetchMs = noctalia.nowMs()
  bxrig.json({ "time", "world", "--json" }, function(result, err)
    loading = false
    if err ~= nil then
      errorText = err
    else
      data = result
      errorText = nil
    end
    render()
  end)
end

function onRefresh()
  fetch()
end

function onCloseClicked()
  panel.close()
end

function onOpen(_context)
  closeButton = noctalia.getSetting("shell.show_close_buttons") ~= false
  panel.setWantsSecondTicks(true)
  render()
  fetch()
end

function onClose()
  panel.setWantsSecondTicks(false)
end

function update()
  if noctalia.nowMs() - lastFetchMs >= REFRESH_MS then
    fetch()
  end
end' & chr( 10 );
