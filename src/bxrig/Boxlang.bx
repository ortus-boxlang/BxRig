// `bxrig boxlang`: the BoxLang developer ecosystem on top of what install.sh puts in place (Java 21, bvm, mvm, BoxLang, MatchBox).
//   status                      what is installed: boxlang, bvm, mvm, matchbox, bx-module, VS Code and the BoxLang extension
//   use VERSION                 `bvm install VERSION` when missing, then `bvm use VERSION` (latest, snapshot or a number)
//   matchbox use VERSION        the same with mvm for MatchBox
//   modules list|search TEXT    the BoxLang modules on ForgeBox (its public API: /api/v1/entries/boxlang-modules, paged 50 at a time)
//   modules install SLUG...     `bx-module install SLUG...`; modules installed|outdated|update wrap bx-module
//   vscode                      `code --install-extension ortus-solutions.vscode-boxlang` and the developer pack
//   links                       the BoxLang sites (docs, AI, Sites, Agents, MatchBox, ForgeBox, Skills, Try BoxLang...)
//   welcome                     writes and opens the getting-started page
// Commands come from the BoxLang docs (bvm, bx-module) and the MatchBox quick installer README (mvm). Exit: 0 done, 4 a tool is missing,
// 6 a command failed.
class Boxlang {
	variables.forgebox = "https://forgebox.io/api/v1";
	variables.extension = "ortus-solutions.vscode-boxlang";
	variables.pack = "ortus-solutions.vscode-boxlang-developer-pack";

	function init( cli, runner = "" ) {
		variables.cli = arguments.cli;
		variables.out = new bxrig.util.Out( variables.cli, "boxlang" );
		variables.proc = new bxrig.util.Proc( arguments.runner );
		variables.http = new bxrig.util.Http( variables.proc );
		return this;
	}

	function links() {
		return [
			{ id: "try", title: "Try BoxLang", url: new bxrig.util.Urls().tryBoxLang(), about: "Write and run BoxLang in the browser" },
			{ id: "boxlang", title: "BoxLang", url: new bxrig.util.Urls().boxlang(), about: "The language" },
			{ id: "docs", title: "BoxLang docs", url: "https://boxlang.ortusbooks.com", about: "The reference and guides" },
			{ id: "ai", title: "BoxLang AI", url: "https://ai.boxlang.io", about: "The AI and agent framework (bx-ai)" },
			{ id: "ai-docs", title: "BoxLang AI docs", url: "https://ai.ortusbooks.com", about: "The bx-ai book" },
			{ id: "agents", title: "BoxLang Agents", url: "https://bxagents.ai", about: "Agents on BoxLang" },
			{ id: "sites", title: "BoxLang Sites", url: "https://bxsites.io", about: "Sites on BoxLang (bx-sites)" },
			{ id: "matchbox", title: "MatchBox", url: new bxrig.util.Urls().matchbox(), about: "Compile BoxLang to native binaries" },
			{ id: "forgebox", title: "ForgeBox", url: "https://forgebox.io", about: "The module and package registry" },
			{ id: "skills", title: "BoxLang skills", url: new bxrig.util.Urls().skillsHub(), about: "Agent skills for BoxLang" },
			{ id: "academy", title: "BoxLang Academy", url: "https://academy.boxlang.io", about: "Free training" },
			{ id: "plans", title: "BoxLang+", url: "https://boxlang.io/plans", about: "Support and premium modules" },
			{ id: "github", title: "GitHub", url: "https://github.com/ortus-boxlang", about: "The source" },
			{ id: "itb", title: "Into the Box", url: "https://intothebox.com", about: "The conference" }
		];
	}

	function versionOf( cmd, args ) {
		if ( !variables.proc.has( arguments.cmd ) ) return "";
		var r = variables.proc.exec( [ arguments.cmd, arguments.args ], 30 );
		return r.exitCode == 0 ? trim( listFirst( r.output, chr( 10 ) ) ) : "";
	}

	function bvmCurrent() {
		if ( !variables.proc.has( "bvm" ) ) return "";
		var r = variables.proc.exec( [ "bvm", "current" ], 30 );
		return r.exitCode == 0 ? trim( listFirst( r.output, chr( 10 ) ) ) : "";
	}

	function status( asJson ) {
		var vsx = variables.proc.has( "code" ) ? variables.proc.exec( [ "code", "--list-extensions" ], 60 ).output : "";
		var d = {
			boxlang: versionOf( "boxlang", "--version" ), bvm: bvmCurrent(),
			matchbox: versionOf( "matchbox", "--version" ), mvm: variables.proc.has( "mvm" ), bx_module: variables.proc.has( "bx-module" ),
			vscode: variables.proc.has( "code" ), vscode_extension: find( variables.extension, vsx ) > 0
		};
		return variables.out.say( "ok", d, arguments.asJson, [
				"BoxLang:   " & ( len( d.boxlang ) ? d.boxlang : "not installed" ) & ( len( d.bvm ) ? "  (bvm: " & d.bvm & ")" : "" ),
				"MatchBox:  " & ( len( d.matchbox ) ? d.matchbox : "not installed" ) & ( d.mvm ? "  (mvm)" : "" ),
				"Modules:   " & ( d.bx_module ? "bx-module is available" : "bx-module not found" ),
				"VS Code:   " & ( d.vscode ? ( d.vscode_extension ? "installed, BoxLang extension present" : "installed, BoxLang extension missing: bxrig boxlang vscode" ) : "not installed" )
			] );
	}

	// `use VERSION` (bvm) or `matchbox use VERSION` (mvm)
	function use( tool, version, asJson ) {
		if ( !variables.proc.has( arguments.tool ) ) return variables.out.say( "precondition", { error: arguments.tool & " was not found" }, arguments.asJson, [ "error: " & arguments.tool & " was not found (install.sh installs it)" ] );
		if ( !reFind( "^[A-Za-z0-9._+-]{1,40}$", arguments.version ) ) return variables.out.say( "precondition", { error: "bad version" }, arguments.asJson, [ "error: bad version " & arguments.version ] );
		var have = variables.proc.exec( [ arguments.tool, "list" ], 60 ).output;
		if ( find( arguments.version, have ) == 0 ) {
			var i = variables.proc.exec( [ arguments.tool, "install", arguments.version ], 1800 );
			if ( i.exitCode != 0 ) return variables.out.say( "failed", { error: trim( i.output ) }, arguments.asJson, [ "error: " & arguments.tool & " install " & arguments.version & " failed" ] );
		}
		var r = variables.proc.exec( [ arguments.tool, "use", arguments.version ], 60 );
		if ( r.exitCode != 0 ) return variables.out.say( "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & arguments.tool & " use " & arguments.version & " failed" ] );
		return variables.out.say( "ok", { tool: arguments.tool, version: arguments.version }, arguments.asJson, [ arguments.tool & " now uses " & arguments.version ] );
	}

	// MatchBox keeps its own files, created on its first run: the home (~/.matchbox, or MATCHBOX_HOME) with config/boxlang.json and logs/,
	// and the user .env file (~/.matchbox.env). A ./.env and a ./boxlang.json in the directory a program runs in are read too.
	function mbHome() {
		var e = new bxrig.util.Env();
		return e.named( "matchboxHome", e.home() & "/.matchbox" );
	}

	function mbConfigFile() { return mbHome() & "/config/boxlang.json"; }

	function mbEnvFile() { return new bxrig.util.Env().home() & "/.matchbox.env"; }

	// `matchbox status | log-level LEVEL | env list|set KEY VALUE|unset KEY` (`matchbox use VERSION` is use( "mvm", ... )).
	function matchbox( action, args, yes, dry, asJson ) {
		var a = arguments.args;
		if ( arguments.action == "status" && !a.len() ) return mbStatus( arguments.asJson );
		if ( arguments.action == "log-level" && a.len() == 1 ) return mbLogLevel( a[ 1 ], arguments.yes, arguments.dry, arguments.asJson );
		if ( arguments.action == "env" && a.len() >= 1 ) return mbEnv( a[ 1 ], a.len() > 1 ? a.slice( 2 ) : [], arguments.yes, arguments.dry, arguments.asJson );
		return variables.out.usage( "usage: bxrig boxlang matchbox use VERSION | status | log-level LEVEL | env list | env set KEY VALUE | env unset KEY", arguments.asJson );
	}

	function mbStatus( asJson ) {
		var e = new bxrig.util.Env();
		var cwd = e.named( "pwd", "." );
		var home = mbHome();
		var logs = [];
		if ( directoryExists( home & "/logs" ) ) for ( var f in directoryList( home & "/logs", false, "name" ) ) if ( right( f, 4 ) == ".log" ) logs.append( f );
		logs.sort( "text" );
		var d = {
			version: versionOf( "matchbox", "--version" ), home: home, home_exists: directoryExists( home ),
			config: mbConfigFile(), config_exists: fileExists( mbConfigFile() ),
			project_config: cwd & "/boxlang.json", project_config_exists: fileExists( cwd & "/boxlang.json" ),
			env_user: mbEnvFile(), env_user_exists: fileExists( mbEnvFile() ),
			env_project: cwd & "/.env", env_project_exists: fileExists( cwd & "/.env" ),
			logs_dir: home & "/logs", logs: logs
		};
		var yn = function( ok, yes, no ) { return ok ? yes : no; };
		return variables.out.say( "ok", d, arguments.asJson, [
				"MatchBox:  " & ( len( d.version ) ? d.version : "not installed" ),
				"Home:      " & d.home & "  (" & yn( d.home_exists, "exists", "created on the first run of a MatchBox that has a home" ) & ")",
				"Config:    " & d.config & "  (" & yn( d.config_exists, "present", "missing" ) & ")",
				"Project:   " & d.project_config & "  (" & yn( d.project_config_exists, "present, layered over the home config", "none" ) & ")",
				"Env files: " & d.env_user & " (" & yn( d.env_user_exists, "present", "none" ) & "), " & d.env_project & " (" & yn( d.env_project_exists, "present", "none" ) & ")",
				"Logs:      " & d.logs_dir & "  (" & logs.len() & " file" & yn( logs.len() == 1, "", "s" ) & ")" & ( logs.len() ? ": " & logs.toList( ", " ) : "" )
			] );
	}

	// Sets logging.rootLevel in the home's config/boxlang.json by editing the one value, so its comments stay. Without a config file it writes a small one.
	function mbLogLevel( level, yes, dry, asJson ) {
		var lv = uCase( trim( arguments.level ) );
		if ( !arrayFind( [ "ERROR", "WARN", "INFO", "DEBUG", "TRACE", "OFF" ], lv ) ) return variables.out.precondition( "bad log level " & arguments.level & " (ERROR, WARN, INFO, DEBUG, TRACE or OFF)", arguments.asJson );
		var file = mbConfigFile();
		var nl = chr( 10 );
		var body = "";
		if ( fileExists( file ) ) {
			var old = fileRead( file );
			// The one `"rootLevel": "X"` token is replaced as exact text (this MatchBox's reReplace has no backreferences), so nothing else moves.
			var token = reMatch( '"rootLevel"\s*:\s*"[A-Za-z]+"', old );
			if ( token.len() != 1 ) return variables.out.precondition( file & " must have exactly one logging.rootLevel to change; edit it by hand", arguments.asJson );
			body = replace( old, token[ 1 ], '"rootLevel": "' & lv & '"' );
		} else {
			body = "{" & nl & chr( 9 ) & '"logging": { "rootLevel": "' & lv & '" }' & nl & "}" & nl;
		}
		if ( !arguments.yes || arguments.dry ) return new bxrig.util.Mutation( variables.out ).show( "set logging.rootLevel to " & lv, { file: file, level: lv }, arguments.asJson, arguments.dry, [ "  file: " & file ] );
		try {
			directoryCreate( getDirectoryFromPath( file ), true, true );
			fileWrite( file, body );
		} catch ( any e ) { return variables.out.failed( "could not write " & file & ": " & e.message, arguments.asJson ); }
		return variables.out.say( "ok", { file: file, level: lv }, arguments.asJson, [ "logging.rootLevel is " & lv & " in " & file ] );
	}

	// The key of one .env line, or "" for a blank line or a comment.
	function mbEnvKey( line ) {
		var t = trim( arguments.line );
		if ( !len( t ) || left( t, 1 ) == chr( 35 ) ) return "";
		if ( left( t, 7 ) == "export " ) t = trim( mid( t, 8 ) );
		var at = find( "=", t );
		return at > 1 ? trim( left( t, at - 1 ) ) : "";
	}

	// `env list` names the keys of ~/.matchbox.env and never shows a value; `set` and `unset` change one line and keep the rest (mode 600).
	function mbEnv( action, args, yes, dry, asJson ) {
		var file = mbEnvFile();
		var nl = chr( 10 );
		var lines = fileExists( file ) ? listToArray( fileRead( file ), nl, true ) : [];
		while ( lines.len() && !len( trim( lines[ lines.len() ] ) ) ) lines.deleteAt( lines.len() );
		if ( arguments.action == "list" && !arguments.args.len() ) {
			var keys = [];
			var shown = [ file & ( fileExists( file ) ? "" : "  (none yet)" ) ];
			for ( var l in lines ) { var k = mbEnvKey( l ); if ( len( k ) ) { keys.append( k ); shown.append( "  " & k ); } }
			return variables.out.say( "ok", { file: file, exists: fileExists( file ), keys: keys }, arguments.asJson, shown );
		}
		var isSet = arguments.action == "set" && arguments.args.len() == 2;
		var isUnset = arguments.action == "unset" && arguments.args.len() == 1;
		if ( !isSet && !isUnset ) return variables.out.usage( "usage: bxrig boxlang matchbox env list | set KEY VALUE | unset KEY", arguments.asJson );
		var key = arguments.args[ 1 ];
		if ( !reFind( "^[A-Za-z_][A-Za-z0-9_]{0,63}$", key ) ) return variables.out.precondition( "bad name " & key & " (letters, digits and _, not starting with a digit)", arguments.asJson );
		var out = [];
		var found = false;
		if ( isSet ) {
			var v = arguments.args[ 2 ];
			if ( find( chr( 10 ), v ) || find( chr( 13 ), v ) ) return variables.out.precondition( "the value cannot contain a line break", arguments.asJson );
			if ( find( '"', v ) && find( "'", v ) ) return variables.out.precondition( "the value cannot contain both quote characters", arguments.asJson );
			var q = ( reFind( "[\s#]", v ) || left( v, 1 ) == '"' || left( v, 1 ) == "'" ) ? ( find( '"', v ) ? "'" : '"' ) : "";
			var entry = key & "=" & q & v & q;
			for ( var l2 in lines ) {
				if ( mbEnvKey( l2 ) == key ) { if ( !found ) out.append( entry ); found = true; } else out.append( l2 );
			}
			if ( !found ) out.append( entry );
		} else {
			for ( var l3 in lines ) { if ( mbEnvKey( l3 ) == key ) found = true; else out.append( l3 ); }
			if ( !found ) return variables.out.precondition( key & " is not set in " & file, arguments.asJson );
		}
		if ( !arguments.yes || arguments.dry ) return new bxrig.util.Mutation( variables.out ).show( ( isSet ? "set " : "remove " ) & key & " in " & file, { file: file, key: key, action: arguments.action }, arguments.asJson, arguments.dry, [ "  file: " & file & " (mode 600)", "  the value is not shown" ] );
		var made = variables.proc.exec( [ "sh", "-c", 'umask 077; touch "$1" && chmod 600 "$1"', "_", file ], 10 );
		if ( made.exitCode != 0 ) return variables.out.failed( "could not create " & file, arguments.asJson );
		try { fileWrite( file, out.toList( nl ) & nl ); } catch ( any e ) { return variables.out.failed( "could not write " & file & ": " & e.message, arguments.asJson ); }
		return variables.out.say( "ok", { file: file, key: key, action: arguments.action }, arguments.asJson, [ ( isSet ? "Set " : "Removed " ) & key & " in " & file ] );
	}

	// ForgeBox: [ { slug, title, version, description } ]. The API (saas-forgebox, api-v1): /entries/<typeSlug>?max=&offset=&searchTerm=;
	// max is capped at 50 per call, so the pages are followed until one comes back short (at most 20 pages).
	function forgeboxModules( term ) {
		var rows = [];
		for ( var page = 0; page < 20; page++ ) {
			var url = variables.forgebox & "/entries/boxlang-modules?orderBy=popular&max=50&offset=" & ( page * 50 ) & ( len( arguments.term ) ? "&searchTerm=" & urlEncodedFormat( arguments.term ) : "" );
			var r = variables.http.get( url, 30 );
			if ( !r.ok ) return { ok: rows.len() > 0, error: "ForgeBox did not answer", rows: rows };
			try {
				var j = jsonDeserialize( r.output );
				var got = j.data.results;
				for ( var e in got ) rows.append( { slug: e.slug, title: e.title ?: e.slug, version: e.latestVersion.version ?: "", description: left( replace( e.summary ?: "", chr( 10 ), " ", "all" ), 100 ) } );
				if ( got.len() < 50 ) break;
			} catch ( any e2 ) { return { ok: rows.len() > 0, error: "unexpected answer from ForgeBox", rows: rows }; }
		}
		return { ok: true, rows: rows };
	}

	function modules( action, args, asJson ) {
		if ( arguments.action == "list" || arguments.action == "search" ) {
			var f = forgeboxModules( arguments.action == "search" && arguments.args.len() ? arguments.args.toList( " " ) : "" );
			if ( !f.ok ) return variables.out.say( "failed", { error: f.error }, arguments.asJson, [ "error: " & f.error ] );
			return variables.out.say( "ok", { modules: f.rows }, arguments.asJson, f.rows.map( function( m ) { return m.slug & "  " & m.version & "  " & m.description; } ) );
		}
		if ( !variables.proc.has( "bx-module" ) ) return variables.out.say( "precondition", { error: "bx-module was not found" }, arguments.asJson, [ "error: bx-module was not found (the BoxLang quick installer or bvm installs it)" ] );
		for ( var a in arguments.args ) if ( !reFind( "^[A-Za-z0-9._@+-]{1,60}$", a ) ) return variables.out.say( "precondition", { error: "bad module name" }, arguments.asJson, [ "error: bad module name " & a ] );
		var words = { install: "install", installed: "list", outdated: "outdated", update: "update" };
		if ( !structKeyExists( words, arguments.action ) ) return variables.out.say( "precondition", { error: "unknown action" }, arguments.asJson, [ "error: unknown action " & arguments.action ] );
		if ( arguments.action == "install" && !arguments.args.len() ) return variables.out.say( "precondition", { error: "name the modules" }, arguments.asJson, [ "error: name the modules to install" ] );
		var argv = [ "bx-module", words[ arguments.action ] ];
		for ( var m in arguments.args ) argv.append( m );
		if ( arguments.action == "update" ) argv.append( "--force" );
		var r = variables.proc.exec( argv, 1800 );
		if ( r.exitCode != 0 ) return variables.out.say( "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: bx-module " & words[ arguments.action ] & " failed" ] );
		return variables.out.say( "ok", { output: trim( r.output ) }, arguments.asJson, [ trim( r.output ) ] );
	}

	function vscode( asJson ) {
		if ( !variables.proc.has( "code" ) ) return variables.out.say( "precondition", { error: "code was not found" }, arguments.asJson, [ "error: VS Code was not found. Install it: bxrig install vscode" ] );
		var done = [];
		for ( var ext in [ variables.extension, variables.pack ] ) {
			var r = variables.proc.exec( [ "code", "--install-extension", ext, "--force" ], 300 );
			if ( r.exitCode == 0 ) done.append( ext );
		}
		if ( !done.len() ) return variables.out.say( "failed", { error: "could not install the extension" }, arguments.asJson, [ "error: could not install the BoxLang extension (is it on your editor's marketplace?)" ] );
		return variables.out.say( "ok", { installed: done }, arguments.asJson, [ "Installed: " & done.toList( ", " ) ] );
	}

	function showLinks( asJson ) {
		return variables.out.say( "ok", { links: links() }, arguments.asJson, links().map( function( l ) { return l.title & "  " & l.url & "  " & l.about; } ) );
	}

	function welcomeFile() { return new bxrig.ConfigService().quiet( true ).cfgHome() & "/bxrig/welcome.html"; }

	function welcomeHtml() {
		var rows = links().map( function( l ) { return '<li><a href="' & l.url & '">' & l.title & '</a> <span>' & l.about & '</span></li>'; } ).toList( chr( 10 ) );
		return '<!doctype html><meta charset="utf-8"><title>Welcome to BxRig</title>' & chr( 10 )
		& '<style>body{font:16px system-ui;background:##0d1117;color:##e6edf3;max-width:46rem;margin:3rem auto;padding:0 1rem}h1{background:linear-gradient(90deg,##00dbff,##00ff78);-webkit-background-clip:text;color:transparent}a{color:##00dbff}li{margin:.5rem 0}span{color:##8b949e}code{background:##161b22;padding:.1rem .4rem;border-radius:4px}</style>' & chr( 10 )
		& '<h1>Welcome to BxRig</h1><p>Your dev rig is set up. BoxLang and MatchBox are installed.</p>' & chr( 10 )
		& '<h2>Start here</h2><ol><li>Open <a href="https://try.boxlang.io">Try BoxLang</a> and run something.</li><li>In a terminal: <code>boxlang --version</code>, then <code>bxrig boxlang modules list</code>.</li><li>Compile a script to a native binary with MatchBox: <code>matchbox script.bxs</code> (docs: <a href="https://matchbox.boxlang.io">matchbox.boxlang.io</a>).</li></ol>' & chr( 10 )
		& '<h2>The BoxLang ecosystem</h2><ul>' & rows & '</ul>' & chr( 10 );
	}

	function welcome( open, asJson ) {
		var f = welcomeFile();
		var dir = getDirectoryFromPath( f );
		if ( !directoryExists( dir ) ) directoryCreate( dir, true );
		fileWrite( f, welcomeHtml() );
		if ( arguments.open && variables.proc.has( "xdg-open" ) ) variables.proc.exec( [ "sh", "-c", 'setsid xdg-open "$1" >/dev/null 2>&1 &', "_", f ], 10 );
		return variables.out.say( "ok", { file: f }, arguments.asJson, [ "Welcome page: " & f ] );
	}
}
