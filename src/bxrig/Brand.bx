// The BxRig brand in text: the logo in three sizes (large in the DOS Rebel FIGlet font, small and word as block art), the tagline and the descriptions used by the README, `--help` and the screens.
// The TUIs paint these with the brand gradient (cyan #00DBFF to green #00FF78); `ansi( lines )` does the same for plain terminal output.
// docs/brand/bxrig-ascii.txt shows every size.
class Brand {
	function name() { return "BxRig"; }
	function tagline() { return "Your dev rig. Beautiful by default."; }
	function oneLiner() { return "BxRig brings an opinionated, beautiful and efficient desktop to Linux, built for developers."; }
	function description() { return "BxRig turns a fresh Linux install into a polished developer rig: a themed desktop, the languages and tools you use, and one terminal screen to manage it all."; }

	// The logo: BXRIG in the DOS Rebel FIGlet font (58 columns, 8 rows), the font `bxrig ascii` uses by default.
	function large() { return new bxrig.Figlet().render( "BXRIG", "dos-rebel" ); }

	// 19 columns, 3 rows: the same letters in half blocks.
	function small() {
		return [
			"█▀▄ █ █ █▀▄ ▀█▀ ▄▀▀",
			"█▀▄  █  █▀▄  █  █ ▄",
			"█▄▀ █ █ █ █ ▄█▄ ▀▄█"
		];
	}

	// The laptop logo as colour pixel art: "large" (48 columns, 17 rows), "medium" (32, 11) or "small" (20, 7). See TuiKit.pixelArt.
	function laptop( size = "large" ) {
		var px = new bxrig.BrandPixels();
		if ( arguments.size == "small" ) return px.small();
		if ( arguments.size == "medium" ) return px.medium();
		return px.large();
	}

	function word() { return "▌BXRIG▐"; }

	// "large", "small" or "word".
	function lines( size = "large" ) {
		if ( arguments.size == "small" ) return small();
		if ( arguments.size == "word" ) return [ word() ];
		return large();
	}

	function width( size = "large" ) {
		var w = 0;
		for ( var l in lines( arguments.size ) ) w = max( w, len( l ) );
		return w;
	}

	// `bxrig version`: the logo and the tagline around the version on a terminal, one line otherwise, or the JSON envelope. Returns the exit code.
	function show( cli, version, asJson, terminal ) {
		if ( arguments.asJson ) println( arguments.cli.envelope( "version", 0, { name: name(), version: arguments.version } ) );
		else {
			if ( arguments.terminal ) { for ( var vl in ansi( large() ) ) println( vl ); println( "" ); }
			println( name() & " " & arguments.version );
			if ( arguments.terminal ) println( tagline() );
		}
		return new bxrig.util.Exit().ok();
	}


	// Lines painted left to right from cyan to green (the brand gradient, see AsciiColor). Without a colour terminal (NO_COLOR set, or `plain`)
	// the lines come back as they are.
	function ansi( lines, plain = false ) {
		var c = new bxrig.AsciiColor();
		if ( arguments.plain || c.disabled() ) return arguments.lines;
		return c.paint( arguments.lines, c.presets().brand );
	}
}
