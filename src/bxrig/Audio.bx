// `bxrig audio status [--json]`: what the sound server says (read only; the volume, outputs and mixing live in the Noctalia bar panel,
// `Super+Ctrl+A`, and in wiremix, the terminal fallback in the Hardware menu). It asks `pactl`, which PipeWire answers through pipewire-pulse.
// Data: { server, default_output, default_input, outputs: [ { name, description, volume, muted, state, default } ], inputs: [ ... ] }
// (volume is the percent of the first channel; monitors of outputs are not listed as inputs).
// Test override: the runner given to the constructor replaces the real process.
// Exit: 0 ok, 2 bad usage, 4 precondition (pactl is not installed, or no sound server answers).
class Audio {
	function init( cli, runner = "" ) {
		variables.cli = arguments.cli;
		variables.out = new bxrig.util.Out( variables.cli, "audio" );
		variables.proc = new bxrig.util.Proc( arguments.runner );
		return this;
	}

	// pactl's JSON for one subcommand ("info", "list sinks"), or "" when it fails or is not JSON.
	function pactlJson( words ) {
		var argv = [ "pactl", "--format=json" ];
		for ( var w in arguments.words ) argv.append( w );
		var r = variables.proc.exec( argv, 15 );
		if ( r.exitCode != 0 ) return "";
		try { return jsonDeserialize( r.output ); } catch ( any e ) { return ""; }
	}

	function str( s, key ) { return structKeyExists( arguments.s, arguments.key ) && isSimpleValue( arguments.s[ arguments.key ] ) ? toString( arguments.s[ arguments.key ] ) : ""; }

	// The percent of the first channel of a volume struct ({ "front-left": { value_percent: "65%" }, ... }); -1 when unknown.
	function percent( vol ) {
		if ( !isStruct( arguments.vol ) ) return -1;
		for ( var ch in structKeyArray( arguments.vol ) ) {
			var c = arguments.vol[ ch ];
			if ( isStruct( c ) && structKeyExists( c, "value_percent" ) ) return int( val( reReplace( c.value_percent, "[^0-9.]", "", "all" ) ) );
		}
		return -1;
	}

	// [ { name, description, volume, muted, state, default } ] from `list sinks` or `list sources`.
	function devices( rows, defaultName, skipMonitors = false ) {
		var out = [];
		if ( !isArray( arguments.rows ) ) return out;
		for ( var r in arguments.rows ) {
			if ( !isStruct( r ) ) continue;
			var name = str( r, "name" );
			if ( arguments.skipMonitors && right( name, 8 ) == ".monitor" ) continue;
			out.append( { name: name, description: str( r, "description" ), volume: percent( structKeyExists( r, "volume" ) ? r.volume : "" ), muted: structKeyExists( r, "mute" ) && r.mute == true, state: lCase( str( r, "state" ) ), default: compare( name, arguments.defaultName ) == 0 } );
		}
		return out;
	}

	function line( kind, d ) {
		return kind & ": " & ( len( d.description ) ? d.description : d.name ) & "  " & ( d.volume >= 0 ? d.volume & "%" : "?" ) & ( d.muted ? " (muted)" : "" ) & ( d.default ? "  [default]" : "" );
	}

	function statusCmd( asJson ) {
		if ( !variables.proc.has( "pactl" ) ) return variables.out.precondition( "pactl is not installed (bxrig install pipewire)", arguments.asJson );
		var info = pactlJson( [ "info" ] );
		if ( !isStruct( info ) ) return variables.out.precondition( "no sound server answered (is pipewire-pulse running? bxrig install pipewire)", arguments.asJson );
		var defOut = str( info, "default_sink_name" );
		var defIn = str( info, "default_source_name" );
		var outputs = devices( pactlJson( [ "list", "sinks" ] ), defOut );
		var inputs = devices( pactlJson( [ "list", "sources" ] ), defIn, true );
		var data = { server: str( info, "server_name" ), default_output: defOut, default_input: defIn, outputs: outputs, inputs: inputs };
		var lines = [ "server: " & ( len( data.server ) ? data.server : "unknown" ) ];
		for ( var o in outputs ) lines.append( line( "output", o ) );
		if ( !outputs.len() ) lines.append( "output: none" );
		for ( var i in inputs ) lines.append( line( "input", i ) );
		if ( !inputs.len() ) lines.append( "input: none" );
		return variables.out.say( "ok", data, arguments.asJson, lines );
	}

	function run( words, asJson = false ) {
		var verb = arguments.words.len() ? arguments.words[ 1 ] : "";
		if ( ( verb == "" || verb == "status" ) && arguments.words.len() <= 1 ) return statusCmd( arguments.asJson );
		return variables.out.usage( "unknown audio command. Usage: audio status [--json]", arguments.asJson );
	}
}
