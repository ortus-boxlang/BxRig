// `bxrig settings export FILE | import FILE [--yes]`: take your BxRig settings to another machine.
//   export   a tar.gz of ~/.config/bxrig (answers.json, shortcuts.json, runner.json, ai.json, menu.json, db.json, ...) without secrets
//            (the keyring and the secrets files stay behind: use `secrets export` for those) and without backups and state
//   import   lists what it would write; with --yes backs up each existing file next to it as NAME.bak-STAMP, then extracts
// Entries must stay under bxrig/ (no absolute paths, no ..). Exit: 0 done, 2 plan without --yes, 4 precondition, 6 failed.
class Settings {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.out = new bxrig.Out( variables.cli, "settings" );
        variables.inst = new bxrig.Installer( arguments.runner );
        variables.proc = variables.inst.proc();
        variables.config = new bxrig.ConfigService().quiet( true );
        return this;
    }

    function root() { return variables.config.cfgHome(); }

    // The files under bxrig/ to export (relative to the config home), no secrets, backups or state.
    function files() {
        var out = [];
        var base = root() & "/bxrig";
        if ( !directoryExists( base ) ) return out;
        for ( var f in directoryList( base, true, "path" ) ) {
            if ( !fileExists( f ) ) continue;
            var rel = "bxrig/" & mid( f, len( base ) + 2, len( f ) );
            if ( reFindNoCase( "secret|key|token|backup|state|\.bak-|\.tmp", rel ) ) continue;
            out.append( rel );
        }
        return out;
    }

    function exportFile( file, force, asJson ) {
        var list = files();
        if ( !list.len() ) return variables.out.say( "precondition", { error: "nothing to export" }, arguments.asJson, [ "error: there are no BxRig settings to export yet" ] );
        if ( fileExists( arguments.file ) && !arguments.force ) return variables.out.say( "precondition", { error: "file exists" }, arguments.asJson, [ "error: " & arguments.file & " exists (add --force to replace it)" ] );
        var argv = [ "tar", "-czf", arguments.file, "-C", root() ];
        for ( var f in list ) argv.append( f );
        var r = variables.proc.exec( argv, 120 );
        if ( r.exitCode != 0 ) return variables.out.say( "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: tar failed" ] );
        return variables.out.say( "ok", { file: arguments.file, files: list }, arguments.asJson, [ "Exported " & list.len() & " files to " & arguments.file & ". Secrets are not included (bxrig secrets export)." ] );
    }

    function entries( file ) {
        var r = variables.proc.exec( [ "tar", "-tzf", arguments.file ], 60 );
        if ( r.exitCode != 0 ) return { ok: false, error: "not a readable archive" };
        var list = [];
        for ( var l in listToArray( r.output, chr( 10 ) ) ) {
            l = trim( l );
            if ( !len( l ) || right( l, 1 ) == "/" ) continue;
            if ( left( l, 1 ) == "/" || find( "..", l ) || left( l, 6 ) != "bxrig/" ) return { ok: false, error: "unsafe entry " & l };
            list.append( l );
        }
        return { ok: true, files: list };
    }

    function importFile( file, yes, asJson ) {
        if ( !fileExists( arguments.file ) ) return variables.out.say( "precondition", { error: "no such file" }, arguments.asJson, [ "error: no such file: " & arguments.file ] );
        var e = entries( arguments.file );
        if ( !e.ok ) return variables.out.say( "precondition", { error: e.error }, arguments.asJson, [ "error: " & e.error ] );
        var clash = e.files.filter( function( f ) { return fileExists( root() & "/" & f ); } );
        var data = { file: arguments.file, files: e.files, existing: clash };
        if ( !arguments.yes ) return variables.out.say( "plan", data, arguments.asJson, [ "Plan: import " & e.files.len() & " files into " & root() & "/bxrig (" & clash.len() & " exist and are backed up first)", "Nothing was changed. Add --yes to apply." ] );
        var stamp = trim( variables.proc.exec( [ "date", "+%Y%m%d-%H%M%S" ], 10 ).output );
        for ( var f in clash ) fileCopy( root() & "/" & f, root() & "/" & f & ".bak-" & stamp );
        var r = variables.proc.exec( [ "tar", "-xzf", arguments.file, "-C", root() ], 120 );
        if ( r.exitCode != 0 ) return variables.out.say( "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: extracting failed" ] );
        return variables.out.say( "ok", data, arguments.asJson, [ "Imported " & e.files.len() & " files (" & clash.len() & " backed up as .bak-" & stamp & "). Run: bxrig init --from-system to re-apply." ] );
    }
}
