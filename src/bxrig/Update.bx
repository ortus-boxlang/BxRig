// `bxrig update check|apply|channel|notifications` and `bxrig system update`: keep BxRig and the system current.
//   channel [stable|beta]        show or set the update channel (~/.config/bxrig/update.json). stable = tagged releases; beta = the
//                                bleeding-edge builds of every push to `development` (snapshots)
//   check [--notify]             compares the running binary's SHA-256 with the one published for the channel
//                                (BASE/CHANNEL/version-latest.properties); also counts pending system updates (`checkupdates`, pacman-contrib)
//                                --notify shows a desktop notification when something is new (noctalia msg notification-show, else notify-send)
//   apply [--yes]                downloads BASE/CHANNEL/bxrig-linux-x86_64 and replaces the installed binary (same folder, atomic move)
//                                after checking its SHA-256 against both its .sha256 file and the signed version-latest.properties
//   signatures                   version-latest.properties is signed with Ed25519 (version-latest.properties.sig, verified with `openssl pkeyutl`
//                                and the public key built into this binary from keys/release.pub). A bad or missing signature is exit 5. A build
//                                without an embedded key (development) does not verify, only checks the SHA-256
//   notifications on|off|status  a user timer (bxrig-update-check.timer, daily) running `bxrig update check --notify`
//   system update [--yes]        snapshot first (snapper or timeshift when present), then `sudo pacman -Syu` and, with yay, `yay -Sua`
// BASE is https://downloads.ortussolutions.com/ortussolutions/bxrig (BXRIG_BASE_URL overrides it). Exit: 0 done, 2 plan without --yes,
// 4 precondition, 5 download or verify failed, 6 a command failed, 10 an update is available (check only).
class Update {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.text = new bxrig.util.Text();
        variables.out = new bxrig.util.Out( variables.cli, "update" );
        variables.proc = new bxrig.util.Proc( arguments.runner );
        variables.pacman = new bxrig.util.Pacman( variables.proc );
        variables.aur = new bxrig.util.Aur( variables.proc );
        variables.systemd = new bxrig.util.Systemd( variables.proc );
        variables.http = new bxrig.util.Http( variables.proc );
        variables.config = new bxrig.ConfigService().quiet( true );
        return this;
    }

    function file() { return variables.config.cfgHome() & "/bxrig/update.json"; }

    function load() {
        return new bxrig.util.JsonStore().read( file(), { channel: "stable", notify: false } );
    }

    function save( d ) {
        new bxrig.util.JsonStore().write( "update-settings", file(), arguments.d );
    }

    function base() { return new bxrig.util.Env().named( "baseUrl", new bxrig.util.Urls().downloads() ); }
    function channels() { return [ "stable", "beta" ]; }

    function channel( name, asJson ) {
        var d = load();
        if ( !len( arguments.name ) ) return variables.out.say( "ok", { channel: d.channel, channels: channels() }, arguments.asJson, [ "Update channel: " & d.channel & " (stable = tagged releases, beta = bleeding-edge builds of every push)" ] );
        if ( !arrayFind( channels(), arguments.name ) ) return variables.out.say( "precondition", { error: "unknown channel" }, arguments.asJson, [ "error: unknown channel " & arguments.name & " (use stable or beta)" ] );
        d.channel = arguments.name;
        save( d );
        return variables.out.say( "ok", { channel: d.channel }, arguments.asJson, [ "Update channel set to " & d.channel & ". Check: bxrig update check" ] );
    }

    // The running binary: BXRIG_SELF, else the first bxrig on PATH, resolved.
    function selfPath() {
        var p = new bxrig.util.Env().named( "self", "" );
        if ( !len( p ) ) p = trim( variables.proc.exec( [ "sh", "-c", "command -v bxrig" ], 10 ).output );
        return len( p ) ? trim( variables.proc.exec( [ "readlink", "-f", p ], 10 ).output ) : "";
    }

    function sha( path ) {
        var r = variables.proc.exec( [ "sha256sum", arguments.path ], 120 );
        return r.exitCode == 0 ? listFirst( trim( r.output ), " " ) : "";
    }

    // The public key file: BXRIG_PUBKEY_FILE (tests; the value none turns the check off), else the key embedded in this build, else "" (no signature check, a development build).
    function pubKeyFile() {
        var f = new bxrig.util.Env().named( "pubkeyFile", "" );
        if ( f == "none" ) return "";
        if ( len( f ) ) return f;
        var pem = new bxrig.ReleaseKey().pem();
        if ( !len( pem ) ) return "";
        var tmp = reReplace( getTempDirectory(), "/+$", "" ) & "/bxrig-pub-" & left( createUUID(), 8 ) & ".pem";
        fileWrite( tmp, pem );
        return tmp;
    }

    // The channel's version-latest.properties, verified with its .sig (Ed25519 via `openssl pkeyutl -verify -rawin`) when a public key is set.
    // { ok, error, signed, ...properties }. With a key, a missing or bad signature is an error (a downgrade to unsigned is refused).
    function props( chan ) {
        var dir = reReplace( getTempDirectory(), "/+$", "" ) & "/bxrig-upd-" & left( createUUID(), 8 );
        directoryCreate( dir, true );
        try {
            var got = variables.http.download( base() & "/" & arguments.chan & "/version-latest.properties", dir & "/p", 30 );
            if ( !got.ok ) return { ok: false, error: "unreachable" };
            var key = pubKeyFile();
            var signed = false;
            if ( len( key ) ) {
                var sg = variables.http.download( base() & "/" & arguments.chan & "/version-latest.properties.sig", dir & "/p.sig", 30 );
                if ( !sg.ok ) return { ok: false, error: "unsigned" };
                var v = variables.proc.exec( [ "openssl", "pkeyutl", "-verify", "-pubin", "-inkey", key, "-rawin", "-in", dir & "/p", "-sigfile", dir & "/p.sig" ], 30 );
                if ( v.exitCode != 0 ) return { ok: false, error: "signature" };
                signed = true;
            }
            var out = { ok: true, signed: signed };
            for ( var kv in new bxrig.util.Props().pairs( fileRead( dir & "/p" ) ) ) out[ kv.key ] = kv.value;
            return out;
        } finally {
            try { directoryDelete( dir, true ); } catch ( any e ) {}
        }
    }

    function propsFailure( p, chan, asJson ) {
        if ( arguments.p.error == "signature" ) return variables.out.say( "official", { error: "signature" }, arguments.asJson, [ "error: the release information for " & arguments.chan & " has an invalid signature. Nothing was changed." ] );
        if ( arguments.p.error == "unsigned" ) return variables.out.say( "official", { error: "unsigned" }, arguments.asJson, [ "error: the release information for " & arguments.chan & " is not signed. Nothing was changed." ] );
        return variables.out.say( "official", { error: "unreachable" }, arguments.asJson, [ "error: could not reach " & base() & "/" & arguments.chan & "/" ] );
    }

    function pendingSystem() {
        if ( !variables.proc.has( "checkupdates" ) ) return -1;
        var r = variables.proc.exec( [ "checkupdates" ], 120 );
        return r.exitCode == 0 ? listToArray( r.output, chr( 10 ) ).len() : 0;
    }

    function notify( title, body ) {
        if ( variables.proc.has( "noctalia" ) && variables.proc.exec( [ "noctalia", "msg", "notification-show", arguments.title, arguments.body ], 15 ).exitCode == 0 ) return true;
        if ( variables.proc.has( "notify-send" ) ) return variables.proc.exec( [ "notify-send", "-a", "BxRig", arguments.title, arguments.body ], 15 ).exitCode == 0;
        return false;
    }

    function check( doNotify, asJson ) {
        var d = load();
        var p = props( d.channel );
        if ( !p.ok ) return propsFailure( p, d.channel, arguments.asJson );
        var mine = sha( selfPath() );
        var newer = len( mine ) && structKeyExists( p, "sha256" ) && mine != p.sha256;
        var system = pendingSystem();
        var data = { channel: d.channel, update_available: newer, latest: p.version ?: "", commit: p.commit ?: "", built_at: p.builtAt ?: "", system_updates: system };
        var lines = [ newer ? "A BxRig update is available on " & d.channel & " (" & ( p.version ?: "" ) & ", " & ( p.commit ?: "" ) & "). Install it: bxrig update apply --yes" : "BxRig is up to date on " & d.channel & "." ];
        if ( system > 0 ) lines.append( system & " system package updates are waiting: bxrig system update" );
        if ( arguments.doNotify && ( newer || system > 0 ) ) notify( "BxRig updates", ( newer ? "A new BxRig build is available. " : "" ) & ( system > 0 ? system & " system updates." : "" ) );
        return variables.out.say( newer ? "update" : "ok", data, arguments.asJson, lines );
    }

    function apply( yes, asJson ) {
        var d = load();
        var p = props( d.channel );
        if ( !p.ok ) return propsFailure( p, d.channel, arguments.asJson );
        var target = selfPath();
        if ( !len( target ) ) return variables.out.say( "precondition", { error: "cannot find the installed bxrig" }, arguments.asJson, [ "error: cannot find the installed bxrig binary" ] );
        var data = { channel: d.channel, target: target, latest: p.version ?: "" };
        if ( structKeyExists( p, "sha256" ) && sha( target ) == p.sha256 ) return variables.out.say( "ok", variables.text.merge( data, { updated: false } ), arguments.asJson, [ "Already on the latest " & d.channel & " build." ] );
        if ( !arguments.yes ) return variables.out.plan( "replace " & target & " with the " & d.channel & " build " & ( p.version ?: "" ), data, arguments.asJson );
        var tmp = target & ".new-" & left( createUUID(), 8 );
        var dl = variables.http.download( base() & "/" & d.channel & "/bxrig-linux-x86_64", tmp, 600 );
        var sum = variables.http.get( base() & "/" & d.channel & "/bxrig-linux-x86_64.sha256", 30 );
        if ( !dl.ok || !sum.ok ) { if ( fileExists( tmp ) ) fileDelete( tmp ); return variables.out.say( "official", { error: "download failed" }, arguments.asJson, [ "error: the download failed" ] ); }
        var got = sha( tmp );
        if ( listFirst( trim( sum.output ), " " ) != got || ( structKeyExists( p, "sha256" ) && p.sha256 != got ) ) { fileDelete( tmp ); return variables.out.say( "official", { error: "checksum mismatch" }, arguments.asJson, [ "error: the SHA-256 does not match; nothing was replaced" ] ); }
        variables.proc.exec( [ "chmod", "755", tmp ], 10 );
        var mv = variables.proc.exec( [ "mv", "-f", tmp, target ], 30 );
        if ( mv.exitCode != 0 ) { if ( fileExists( tmp ) ) fileDelete( tmp ); return variables.out.say( "failed", { error: trim( mv.output ) }, arguments.asJson, [ "error: could not replace " & target ] ); }
        return variables.out.say( "ok", variables.text.merge( data, { updated: true } ), arguments.asJson, [ "Updated " & target & " to the " & d.channel & " build " & ( p.version ?: "" ) & "." ] );
    }

    function unit( kind ) { return variables.config.cfgHome() & "/systemd/user/bxrig-update-check." & arguments.kind; }

    function notifications( action, asJson ) {
        var d = load();
        if ( arguments.action == "status" ) return variables.out.say( "ok", { enabled: d.notify }, arguments.asJson, [ "Update notifications: " & ( d.notify ? "on (daily)" : "off" ) ] );
        if ( arguments.action == "off" ) {
            variables.systemd.disable( "bxrig-update-check.timer", true );
            d.notify = false; save( d );
            return variables.out.say( "ok", { enabled: false }, arguments.asJson, [ "Update notifications are off." ] );
        }
        if ( arguments.action != "on" ) return variables.out.say( "usage", {}, arguments.asJson, [ new bxrig.CommandSpec().usage( "update notifications" ) ] );
        var svc = { name: "update-service", target: unit( "service" ), mode: "644", content: new bxrig.util.SystemdUnit().render( [ { name: "Unit", lines: [ "Description=BxRig update check" ] }, { name: "Service", lines: [ "Type=oneshot", "ExecStart=sh -c 'PATH=$HOME/.local/bin:$PATH bxrig update check --notify; true'" ] } ] ) };
        var tim = { name: "update-timer", target: unit( "timer" ), mode: "644", content: new bxrig.util.SystemdUnit().render( [ { name: "Unit", lines: [ "Description=BxRig daily update check" ] }, { name: "Timer", lines: [ "OnCalendar=daily", "RandomizedDelaySec=1h", "Persistent=true" ] }, { name: "Install", lines: [ "WantedBy=timers.target" ] } ] ) };
        for ( var e in [ svc, tim ] ) { var st = variables.config.configState( e ); if ( st != "drifted" && st != "blocked" ) variables.config.configWrite( e, e.content, "apply", true, false ); }
        variables.systemd.reload( true );
        var r = variables.systemd.enable( "bxrig-update-check.timer", true );
        if ( r.exitCode != 0 ) return variables.out.say( "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: could not start the timer" ] );
        d.notify = true; save( d );
        return variables.out.say( "ok", { enabled: true }, arguments.asJson, [ "Update notifications are on: a daily check, shown as a desktop notification." ] );
    }

    // `system update [--yes]`
    function systemUpdate( yes, asJson ) {
        var snap = variables.proc.has( "snapper" ) ? [ "sudo", "snapper", "create", "--description", "before bxrig system update" ] : ( variables.proc.has( "timeshift" ) ? [ "sudo", "timeshift", "--create", "--comments", "before bxrig system update" ] : [] );
        var steps = [];
        if ( snap.len() ) steps.append( snap );
        steps.append( variables.pacman.upgradeArgv() );
        if ( variables.aur.available() ) steps.append( variables.aur.upgradeArgv() );
        var data = { steps: steps.map( function( s ) { return s.toList( " " ); } ), snapshot: snap.len() > 0 };
        if ( !arguments.yes ) {
            var shown = data.steps.map( function( st ) { return "  " & st; } );
            shown.append( snap.len() ? "A snapshot is taken first." : "No snapshot tool found (snapper or timeshift): the update runs without one." );
            return variables.out.plan( "", data, arguments.asJson, false, shown );
        }
        for ( var s in steps ) {
            var r = variables.proc.exec( s, 3600 );
            if ( r.exitCode != 0 ) return variables.out.say( "failed", { error: s.toList( " " ) & " failed" }, arguments.asJson, [ "error: " & s.toList( " " ) & " failed (exit " & r.exitCode & ")" ] );
        }
        return variables.out.say( "ok", data, arguments.asJson, [ "The system is up to date." ] );
    }
}
