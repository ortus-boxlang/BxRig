// `bxrig keys mac [on|off|status] [--yes]`: the Mac-style Super keys (Super+C, Super+V, Super+Tab) are xremap's job; this turns that
// service on or off without removing anything (`systemctl --user enable --now xremap` / `disable --now xremap`). The unit is the one
// `setup xremap` wrote. Exit: 0 done, 2 plan without --yes, 4 precondition (the unit is not installed), 6 systemctl failed.
class MacKeys {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.proc = new bxrig.util.Proc( arguments.runner );
        variables.systemd = new bxrig.util.Systemd( variables.proc );
        variables.config = new bxrig.ConfigService().quiet( true );
        return this;
    }

    function unitFile() { return variables.config.cfgHome() & "/systemd/user/xremap.service"; }
    function active() { return variables.systemd.isActive( "xremap", true ); }

    function status( asJson ) {
        var on = active();
        return variables.cli.say( "keys mac status", "ok", { installed: fileExists( unitFile() ), active: on }, arguments.asJson, [ "Mac-style keys: " & ( on ? "on" : "off" ) & ( fileExists( unitFile() ) ? "" : " (not set up: bxrig setup xremap)" ) ] );
    }

    function set( on, yes, asJson ) {
        var cmd = "keys mac " & ( arguments.on ? "on" : "off" );
        if ( !fileExists( unitFile() ) ) return variables.cli.say( cmd, "precondition", { error: "xremap is not set up" }, arguments.asJson, [ "error: xremap is not set up. Run: bxrig setup xremap --yes" ] );
        var argv = arguments.on ? variables.systemd.enableArgv( "xremap", true ) : variables.systemd.disableArgv( "xremap", true );
        if ( !arguments.yes ) return variables.cli.scoped( cmd ).plan( argv.toList( " " ), { command: argv }, arguments.asJson );
        var r = variables.proc.exec( argv, 30 );
        if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return variables.cli.say( cmd, "ok", { active: arguments.on }, arguments.asJson, [ "Mac-style keys are " & ( arguments.on ? "on." : "off. Super+C and Super+V are plain Super shortcuts again." ) ] );
    }
}
