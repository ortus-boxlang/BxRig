// `bxrig quicklook [PATH]`: a Quick Look style preview with Kiview (`kiview -s PATH` previews a file or folder; with no PATH, or a
// folder, `kiview DIR` shows an overview of the folder). Kiview's README says it has no Dolphin integration yet, so there is no Space
// key in Dolphin: bind this command yourself, or use Dolphin's Preview panel (F11) or Strata's built-in preview.
// Exit: 0 launched, 4 precondition (Kiview missing, path missing), 6 Kiview failed.
class Quicklook {
	function init( cli, runner = "" ) {
		variables.cli = arguments.cli;
		variables.out = new bxrig.util.Out( variables.cli, "quicklook" );
		variables.inst = new bxrig.Installer( arguments.runner );
		return this;
	}

	function run( path, dryRun, asJson ) {
		var target = len( arguments.path ) ? arguments.path : new bxrig.util.Env().named( "pwd", "." );
		if ( !fileExists( target ) && !directoryExists( target ) ) return variables.out.say( "precondition", { error: "No such file or folder: " & target }, arguments.asJson, [ "error: no such file or folder: " & target ] );
		var have = variables.inst.proc().exec( [ "sh", "-c", "command -v kiview" ], 10 ).exitCode == 0;
		if ( !have ) return variables.out.say( "precondition", { error: "kiview is not installed" }, arguments.asJson, [ "error: kiview is not installed. Install it: bxrig install kiview" ] );
		// a file or a chosen path is a selection (-s); a folder with no path given is the overview
		var argv = len( arguments.path ) ? [ "kiview", "-s", target ] : [ "kiview", target ];
		var data = { path: target, argv: argv };
		if ( arguments.dryRun ) return variables.out.say( "ok", data, arguments.asJson, [ "Dry run: " & argv.toList( " " ), "Nothing was started." ] );
		var r = variables.inst.proc().exec( argv, 3600 );
		if ( r.exitCode != 0 ) return variables.out.say( "failed", { error: "kiview failed (exit " & r.exitCode & ")" }, arguments.asJson, [ "error: kiview failed (exit " & r.exitCode & ")" ] );
		return variables.out.say( "ok", data, arguments.asJson, [] );
	}
}
