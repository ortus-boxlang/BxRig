// `bxrig ai models`: local models through Ollama.
//   list | ps                the models on disk | the models loaded now (`ollama list`, `ollama ps`)
//   pull NAME                download a model (shows Ollama's progress; the Ollama service must be running)
//   rm NAME --yes            delete a model from disk (plan without --yes)
//   enable [--yes]           start the Ollama service now and at boot (`sudo systemctl enable --now ollama`, the unit the package ships)
//   status                   whether Ollama is installed and its service is running
// A model name is letters, digits and . _ : / - (for example qwen3:8b). It is passed as one argument, never through a shell.
// Exit: 0 done, 2 usage or plan without --yes, 4 precondition (Ollama missing, bad name), otherwise Ollama's own exit code.
class AiModels {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.proc = new bxrig.util.Proc( arguments.runner );
        variables.systemd = new bxrig.util.Systemd( variables.proc );
        return this;
    }

    function hasOllama() { return variables.proc.has( "ollama" ); }

    function missing( cmd, asJson ) {
        return variables.cli.say( arguments.cmd, "precondition", { error: "Ollama is not installed" }, arguments.asJson, [ "error: Ollama is not installed. Install it: bxrig install ollama" ] );
    }

    // `ai models list|ps`
    function show( what, asJson ) {
        var cmd = "ai models " & arguments.what;
        if ( !hasOllama() ) return missing( cmd, arguments.asJson );
        var r = variables.proc.exec( [ "ollama", arguments.what ], 30 );
        if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ), "Is the service running? bxrig ai models enable" ] );
        return variables.cli.say( cmd, "ok", { output: trim( r.output ) }, arguments.asJson, [ trim( r.output ) ] );
    }

    // `ai models pull NAME`
    function pull( name, asJson ) {
        var cmd = "ai models pull";
        if ( !new bxrig.util.Names().valid( "model", arguments.name ) ) return variables.cli.say( cmd, "usage", { error: "Bad model name" }, arguments.asJson, [ "error: a model name is letters, digits and . _ : / - (for example qwen3:8b)" ] );
        if ( !hasOllama() ) return missing( cmd, arguments.asJson );
        if ( arguments.asJson ) {
            var r = variables.proc.exec( [ "ollama", "pull", arguments.name ], 7200 );
            return variables.cli.say( cmd, r.exitCode == 0 ? "ok" : "failed", { model: arguments.name, output: trim( r.output ) }, true );
        }
        var run = systemExecute( "ollama", [ "pull", arguments.name ], 0, false, ".", "", "", true, {}, true );
        if ( run.exitCode != 0 ) println( "Is the service running? bxrig ai models enable" );
        return run.exitCode;
    }

    // `ai models rm NAME --yes`
    function remove( name, yes, asJson ) {
        var cmd = "ai models rm";
        if ( !new bxrig.util.Names().valid( "model", arguments.name ) ) return variables.cli.say( cmd, "usage", { error: "Bad model name" }, arguments.asJson, [ "error: bad model name" ] );
        if ( !hasOllama() ) return missing( cmd, arguments.asJson );
        if ( !arguments.yes ) return variables.cli.say( cmd, "plan", { model: arguments.name }, arguments.asJson, [ "Plan: delete the model " & arguments.name & " from disk.", "Nothing was changed. Add --yes to apply." ] );
        var r = variables.proc.exec( [ "ollama", "rm", arguments.name ], 120 );
        if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return variables.cli.say( cmd, "ok", { model: arguments.name }, arguments.asJson, [ trim( r.output ) ] );
    }

    function serviceActive() { return variables.systemd.isActive( "ollama" ); }

    // `ai models status`
    function status( asJson ) {
        var inst = hasOllama();
        var active = inst && serviceActive();
        return variables.cli.say( "ai models status", "ok", { installed: inst, service_active: active }, arguments.asJson, [ "Ollama: " & ( inst ? "installed" : "not installed" ), "Service: " & ( active ? "running" : "not running" ) ] );
    }

    // `ai models enable [--yes]`
    function enable( yes, dryRun, asJson ) {
        var cmd = "ai models enable";
        if ( !hasOllama() ) return missing( cmd, arguments.asJson );
        var argv = variables.systemd.enableArgv( "ollama", false, true );
        if ( !arguments.yes || arguments.dryRun ) return variables.cli.say( cmd, arguments.dryRun ? "ok" : "plan", { command: argv }, arguments.asJson, [ ( arguments.dryRun ? "Dry run" : "Plan" ) & ": " & argv.toList( " " ), "Nothing was changed." & ( arguments.dryRun ? "" : " Add --yes to apply." ) ] );
        var r = variables.proc.exec( argv, 120 );
        if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
        return variables.cli.say( cmd, "ok", {}, arguments.asJson, [ "The Ollama service is enabled and running." ] );
    }
}
