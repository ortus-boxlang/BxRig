// `bxrig system lock | suspend | logout | reboot | shutdown [--yes] [--dry-run]`: the session actions of Omarchy's System menu.
// Inside Hyprland with Noctalia they go through its IPC (`noctalia msg session lock|suspend|logout|reboot|shutdown`, Noctalia docs v5);
// anywhere else (Plasma, no Noctalia) through systemd: `loginctl lock-session`, `systemctl suspend|reboot|poweroff`,
// `loginctl terminate-session $XDG_SESSION_ID`. Lock and suspend act at once. Logout, reboot and shutdown end your session, so they are a
// plan until --yes. Exit: 0 done, 2 plan without --yes or bad usage, 4 nothing can do it here, 6 the command failed.
class SystemActions {
    function init( cli, runner = "" ) {
        variables.cli = arguments.cli;
        variables.out = new bxrig.util.Out( variables.cli, "system" );
        variables.proc = new bxrig.util.Proc( arguments.runner );
        variables.systemd = new bxrig.util.Systemd( variables.proc );
        return this;
    }

    function verbs() { return [ "lock", "suspend", "logout", "reboot", "shutdown" ]; }
    function needsYes( verb ) { return arrayFind( [ "logout", "reboot", "shutdown" ], arguments.verb ) > 0; }

    // The command for a verb: through Noctalia when it is the running shell, else systemd. Returns { argv, via } or an empty struct.
    function command( verb ) {
        var v = arguments.verb;
        var hypr = new bxrig.util.Desktop().inHyprland();
        if ( hypr && variables.proc.has( "noctalia" ) ) return { argv: [ "noctalia", "msg", "session", v ], via: "noctalia" };
        if ( v == "lock" ) return variables.proc.has( "loginctl" ) ? { argv: [ "loginctl", "lock-session" ], via: "systemd" } : {};
        if ( v == "logout" ) {
            var sid = getSystemSetting( "XDG_SESSION_ID", "" );
            return variables.proc.has( "loginctl" ) && len( sid ) ? { argv: [ "loginctl", "terminate-session", sid ], via: "systemd" } : {};
        }
        if ( !variables.systemd.available() ) return {};
        return { argv: variables.systemd.powerArgv( v ), via: "systemd" };
    }

    function run( verb, yes, dryRun, asJson ) {
        if ( !arrayFind( verbs(), arguments.verb ) ) return variables.out.say( "usage", { error: "unknown action " & arguments.verb }, arguments.asJson, [ new bxrig.CommandSpec().usage( "system" ) ] );
        var c = command( arguments.verb );
        if ( structIsEmpty( c ) ) return variables.out.say( "precondition", { error: "nothing here can do " & arguments.verb }, arguments.asJson, [ "error: " & arguments.verb & " needs Noctalia (in Hyprland) or systemd (loginctl, systemctl), and neither was found" ] );
        var data = { action: arguments.verb, via: c.via, command: c.argv.toList( " " ) };
        if ( arguments.dryRun || ( needsYes( arguments.verb ) && !arguments.yes ) ) {
            var dry = arguments.dryRun;
            return variables.out.say( dry ? "ok" : "plan", data, arguments.asJson, [ ( dry ? "Dry run" : "Plan" ) & ": " & arguments.verb & " with `" & data.command & "`" & ( needsYes( arguments.verb ) ? " (ends your session)" : "" ), dry ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." ], dry );
        }
        var r = variables.proc.exec( c.argv, 30 );
        return variables.out.say( r.exitCode == 0 ? "ok" : "failed", data, arguments.asJson, [ r.exitCode == 0 ? arguments.verb & ": done" : "error: " & arguments.verb & " failed: " & trim( r.output ) ] );
    }
}
