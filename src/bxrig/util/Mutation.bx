// The mutation protocol of COMMAND-CONTRACT section 2, once: a list of argv commands is shown as a plan (exit 2) until --yes, as a dry run (exit 0)
// with --dry-run, and otherwise run in order; the first failure stops the run (exit 6). The wording is part of the contract.
//   new bxrig.util.Mutation( out, proc ).run( title, cmds, yes, dry, asJson, data, shown, timeout ) -> exit code
// out is an Out bound to the command (or Cli.scoped( "x" )), proc a Proc. `shown` adds lines (what will be written) before the commands in the plan.
class Mutation {
    function init( out, proc ) {
        variables.out = arguments.out;
        variables.proc = arguments.proc;
        return this;
    }

    function run( title, cmds, yes, dry, asJson, data = {}, shown = [], timeout = 600 ) {
        var d = arguments.data;
        d.commands = arguments.cmds.map( function( c ) { return c.toList( " " ); } );
        if ( !arguments.yes || arguments.dry ) {
            var lines = [ ( arguments.dry ? "Dry run: " : "Plan: " ) & arguments.title ];
            for ( var s in arguments.shown ) lines.append( "  " & s );
            for ( var c in arguments.cmds ) lines.append( "  " & c.toList( " " ) );
            lines.append( arguments.dry ? "Nothing was changed." : "Nothing was changed. Add --yes to apply." );
            return variables.out.say( arguments.dry ? "ok" : "plan", d, arguments.asJson, lines, arguments.dry );
        }
        for ( var x in arguments.cmds ) {
            var r = variables.proc.exec( x, arguments.timeout );
            if ( r.exitCode != 0 ) return variables.out.say( "failed", { error: trim( r.output ), step: x.toList( " " ) }, arguments.asJson, [ "error: " & x.toList( " " ) & ": " & trim( r.output ) ] );
        }
        return variables.out.say( "ok", d, arguments.asJson, [ arguments.title & ": done" ] );
    }
}
