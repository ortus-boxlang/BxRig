// Seconds since 1970 and back, in UTC, with no date library: the one home of "now" and of the time text of backups, logs and timelines.
// BXRIG_NOW_EPOCH fixes "now" in tests. No state. BackupTimeline forwards to it so existing callers keep working.
class Clock {
	// Days from 1970-01-01 to a civil date (Howard Hinnant's algorithm).
	function daysFromCivil( y, m, d ) {
		var yy = arguments.m <= 2 ? arguments.y - 1 : arguments.y;
		var era = int( ( yy >= 0 ? yy : yy - 399 ) / 400 );
		var yoe = yy - era * 400;
		var mp = ( arguments.m + 9 ) mod 12;
		var doy = int( ( 153 * mp + 2 ) / 5 ) + arguments.d - 1;
		var doe = yoe * 365 + int( yoe / 4 ) - int( yoe / 100 ) + doy;
		return era * 146097 + doe - 719468;
	}

	// Seconds since 1970 for "2026-11-13T15:30:00", "2026-11-13 15:30:00" or with a trailing Z or fractions. 0 when it cannot be read.
	function epoch( text ) {
		var t = trim( arguments.text );
		if ( !reFind( "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}", t ) ) return 0;
		var y = int( val( mid( t, 1, 4 ) ) );
		var mo = int( val( mid( t, 6, 2 ) ) );
		var d = int( val( mid( t, 9, 2 ) ) );
		var hh = int( val( mid( t, 12, 2 ) ) );
		var mi = int( val( mid( t, 15, 2 ) ) );
		var ss = int( val( mid( t, 18, 2 ) ) );
		return daysFromCivil( y, mo, d ) * 86400 + hh * 3600 + mi * 60 + ss;
	}

	// Now in seconds since 1970 (BXRIG_NOW_EPOCH overrides it).
	function nowEpoch() {
		var forced = new bxrig.util.Env().named( "nowEpoch", "" );
		if ( len( forced ) ) return int( val( forced ) );
		return epoch( dateTimeFormat( dateConvert( "local2utc", now() ), "yyyy-MM-dd'T'HH:mm:ss" ) );
	}

	// "2026-11-15T21:42:10Z" for seconds since 1970.
	function iso( epoch ) {
		var e = arguments.epoch;
		var days = int( e / 86400 );
		var rest = e - days * 86400;
		var z = days + 719468;
		var era = int( ( z >= 0 ? z : z - 146096 ) / 146097 );
		var doe = z - era * 146097;
		var yoe = int( ( doe - int( doe / 1460 ) + int( doe / 36524 ) - int( doe / 146096 ) ) / 365 );
		var y = yoe + era * 400;
		var doy = doe - ( 365 * yoe + int( yoe / 4 ) - int( yoe / 100 ) );
		var mp = int( ( 5 * doy + 2 ) / 153 );
		var d = doy - int( ( 153 * mp + 2 ) / 5 ) + 1;
		var m = mp < 10 ? mp + 3 : mp - 9;
		if ( m <= 2 ) y++;
		var two = function( n ) { return n < 10 ? "0" & n : n & ""; };
		return y & "-" & two( m ) & "-" & two( d ) & "T" & two( int( rest / 3600 ) ) & ":" & two( int( ( rest mod 3600 ) / 60 ) ) & ":" & two( rest mod 60 ) & "Z";
	}
}
