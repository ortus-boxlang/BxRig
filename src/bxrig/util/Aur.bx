// The AUR through its helper (yay or paru) and its web API. Repository packages are Pacman.bx. Argv arrays only.
class Aur {
	function init( proc = "" ) {
		variables.proc = isSimpleValue( arguments.proc ) ? new bxrig.util.Proc( arguments.proc ) : arguments.proc;
		variables.http = new bxrig.util.Http( variables.proc );
		return this;
	}

	// The helpers that build AUR packages, in the order they are preferred.
	function helpers() { return [ "yay", "paru" ]; }

	// The helper program that builds AUR packages: the first of helpers() that is installed (yay when none is).
	function helper() {
		for ( var h in helpers() ) if ( variables.proc.has( h ) ) return h;
		return "yay";
	}

	// True when a helper (yay or paru) is installed.
	function available() {
		for ( var h in helpers() ) if ( variables.proc.has( h ) ) return true;
		return false;
	}

	// yay -S --needed --noconfirm PKG...
	function installArgv( pkgs ) {
		var argv = [ helper(), "-S", "--needed", "--noconfirm" ];
		for ( var p in ( isArray( arguments.pkgs ) ? arguments.pkgs : [ arguments.pkgs ] ) ) argv.append( p );
		return argv;
	}

	// yay -Sua --noconfirm (upgrade the AUR packages)
	function upgradeArgv() { return [ helper(), "-Sua", "--noconfirm" ]; }

	// The AUR packages that have a newer version (`yay -Qua`, same for paru): { ok, rows, error }. Like pacman -Qu it exits 1 and prints
	// nothing when there are none, which is not an error. Rows: [ { name, old, new } ].
	function pendingUpdates() {
		var r = variables.proc.exec( [ helper(), "-Qua" ], 120 );
		var rows = new bxrig.util.Pacman( variables.proc ).parseUpgrades( r.output );
		if ( r.exitCode == 0 || rows.len() || !len( trim( r.output ) ) ) return { ok: true, rows: rows, error: "" };
		return { ok: false, rows: [], error: trim( variables.proc.why( r ) ) };
	}

	// The RPC base URL (BXRIG_AUR_URL for tests).
	function baseUrl() { return new bxrig.util.Env().named( "aurUrl", "https://aur.archlinux.org/rpc/v5" ); }

	// GET one RPC path: { ok, output, exitCode } (the raw text; no redirects followed, like the website's API).
	function rpc( path ) { return variables.http.get( baseUrl() & arguments.path, 20, false ); }
}
