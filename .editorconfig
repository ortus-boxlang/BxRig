# One style for the files BxRig packs and writes (see tests/format-test.sh, which CI runs).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# fish_indent's own style
[*.fish]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
