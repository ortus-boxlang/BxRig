# BxRig's one format: tabs for indentation, shown 4 wide. scripts/format.sh applies it and CI checks it (--check).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# YAML does not allow tabs
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown: indentation and trailing spaces carry meaning
[*.md]
indent_style = unset
trim_trailing_whitespace = false
